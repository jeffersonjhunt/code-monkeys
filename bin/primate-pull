#!/usr/bin/env bash
#
# primate-pull — ensure <image>:latest exists locally, pulling it from the fleet
# registry if it does not.
#
#   primate-pull minion            # one image
#   primate-pull codemonkey minion # several; one pull covers them all
#   primate-pull --login           # store the registry's pull credential (a secret on STDIN, never argv)
#   primate-pull --registry        # print the configured registry (scripts use it)
#
# This is THE place the pull lives. It used to be copied into `vault`,
# `bin/sops`, `bin/age` and `bin/age-keygen` — and the two shims that needed it
# most, `bin/aws` and `bin/spark-bench`, never got a copy. Every call site now
# goes through here, so a fix lands once.
#
# WHERE (g.deceiver forge F4): the fleet's images moved from AWS ECR (retired, and
# refused here) to a self-hosted Harbor. This repo is public and names no host:
# the registry comes from $CODEMONKEYS_REGISTRY or ~/.config/code-monkeys/registry.conf
# (a CODEMONKEYS_REGISTRY=<host:port> line). None configured = exit 2, nothing pulled.
#
# AUTH is a FILE, not `docker login` into the shared ~/.docker and not a keychain:
# `primate-pull --login` (secret on stdin; user $CODEMONKEYS_REGISTRY_USER, default
# robot$primate-pull — pull on the codemonkeys project only) writes
# ~/.config/code-monkeys/docker/config.json (0600, no credsStore), and every pull
# runs with DOCKER_CONFIG pointed there. That works over ssh and from a zoo/tmux
# launch window on a Mac, where Docker Desktop's keychain store fails (-25308) —
# the reason the old ECR path used a credential helper. The registry's CA must be
# trusted by the docker DAEMON (a host: /etc/docker/certs.d/<registry>/ca.crt; a
# Mac: the forge CA in the System keychain, then restart Docker Desktop).
#
# Env:
#   CODEMONKEYS_REGISTRY        the registry (else registry.conf)
#   CODEMONKEYS_CONF            registry.conf's path
#   CODEMONKEYS_DOCKER_CONFIG   the credential dir (default ~/.config/code-monkeys/docker)
#   CODEMONKEYS_REGISTRY_USER   --login's user (default robot$primate-pull)
#

set -uo pipefail

ME="primate-pull"
NS="codemonkeys"
# the lib sits in ../primates beside this script's REAL path (bin/ is symlinked into ~/.local/bin one file at a time)
_self="$0"
while [ -L "$_self" ]; do
  _l="$(readlink "$_self")"; case "$_l" in /*) _self="$_l" ;; *) _self="$(dirname "$_self")/$_l" ;; esac
done
# shellcheck source=../primates/registry-lib.sh
. "$(cd "$(dirname "$_self")" && pwd)/../primates/registry-lib.sh" || { echo "${ME}: registry-lib.sh not found" >&2; exit 1; }

if [[ "$#" -lt 1 ]]; then
  echo "Usage: ${ME} <image> [image...] | --login | --registry" >&2
  exit 2
fi
DCFG="$(cm_docker_config)"
case "$1" in
  --registry) REG="$(cm_registry "$ME")" || exit 2; printf '%s\n' "$REG"; exit 0 ;;
  --login)    REG="$(cm_registry "$ME")" || exit 2; cm_write_auth "$REG" "${CODEMONKEYS_REGISTRY_USER:-robot\$primate-pull}"; exit $? ;;
  -*)         echo "${ME}: unknown option $1" >&2; exit 2 ;;
esac

# ------------------------------------------------------------------ docker ---

DOCKER_CMD=""

_docker() {
  if [[ -z "$DOCKER_CMD" ]]; then
    if docker version >/dev/null 2>&1; then
      DOCKER_CMD="docker"
    elif sudo -n docker version >/dev/null 2>&1; then
      DOCKER_CMD="sudo"
    else
      echo "${ME}: cannot reach a docker daemon (tried 'docker' and 'sudo -n docker')." >&2
      echo "  On a host: is Docker running? Inside a primate: is the socket bind-mounted?" >&2
      exit 1
    fi
  fi
  if [[ "$DOCKER_CMD" == "sudo" ]]; then
    # sudo resets the environment: carry DOCKER_CONFIG (the pull credential) and PATH across
    sudo -n env HOME="$HOME" PATH="$PATH" ${DOCKER_CONFIG:+DOCKER_CONFIG="$DOCKER_CONFIG"} docker "$@"
  else
    docker "$@"
  fi
}

# -------------------------------------------------------------------- main ---

# Nothing to do at all? Then never touch the registry, the network, or the daemon.
WANTED=()
for img in "$@"; do
  if ! _docker image inspect "${img}:latest" >/dev/null 2>&1; then
    WANTED+=("$img")
  fi
done
if [[ "${#WANTED[@]}" -eq 0 ]]; then
  exit 0
fi

# only now is a registry needed: a machine whose images are all local never needs registry.conf
REG="$(cm_registry "$ME")" || exit 2
echo "${ME}: pulling from ${REG}: ${WANTED[*]}" >&2
if [[ ! -s "$DCFG/config.json" ]]; then
  echo "${ME}: no pull credential in $DCFG/config.json — store it once with" >&2
  echo "  <the primate-pull robot's secret> | ${ME} --login" >&2
  exit 1
fi

rc=0
for img in "${WANTED[@]}"; do
  ref="${REG}/${NS}/${img}:latest"
  if DOCKER_CONFIG="$DCFG" _docker pull -q "$ref" >/dev/null; then
    _docker tag "$ref" "${img}:latest"
  else
    echo "${ME}: ${img} could not be pulled (${ref})." >&2
    echo "  Check: the credential (${ME} --login), the daemon's trust of ${REG}'s CA, or build" >&2
    echo "  locally: cd primates && make ${img}.build" >&2
    rc=1
  fi
done
exit $rc
