#!/usr/bin/env bash
#
# age — containerized age via the `nyckel` primate
#
# age + sops are NEVER installed on a host or a Mac (no brew, ever) — they run
# from the minimal `nyckel` image (Alpine + age + sops only). This shim:
#   - pulls nyckel from ECR on first use (needs ~/.aws creds), like primate()
#   - mounts ~/.config/sops/age read-only (identity for -d / -i)
#   - mounts the enclosing git repo root (or cwd) at the same path
#
# Pipes work: `age -r age1... < plain > enc` (stdin/stdout are passed through).
#

set -e

_TOOL="age"
_IMAGE="nyckel"

# One place ensures an image is local, for every shim and for primate(): the
# `primate-pull` sibling of this script — the repo's bin/, or ~/.local/bin where
# setup symlinks that whole directory. This used to be ~50 lines copied into
# each of four files, and the copies drifted.
_PP="$(cd -P "$(dirname "$0")" && pwd)/primate-pull"
if [[ ! -x "$_PP" ]]; then
  _PP="$(command -v primate-pull || true)"
fi
if [[ -z "$_PP" ]]; then
  echo "${_TOOL} shim: primate-pull not found; cannot ensure ${_IMAGE} is local." >&2
  exit 1
fi
"$_PP" "$_IMAGE"

_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
_cwd="$(pwd)"

_key_mount=()
if [[ -d "$HOME/.config/sops/age" ]]; then
  _key_mount=(--volume "$HOME/.config/sops/age:/age:ro")
fi

_tty=(-i)
if [[ -t 0 && -t 1 ]]; then
  _tty=(-it)
fi

exec docker run --rm "${_tty[@]}" \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  "${_key_mount[@]}" \
  --volume "${_root}:${_root}" \
  --workdir "${_cwd}" \
  "${_IMAGE}" "${_TOOL}" "$@"
