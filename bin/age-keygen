#!/usr/bin/env bash
#
# age-keygen — containerized age-keygen via the `nyckel` primate
#
# age + sops are NEVER installed on a host or a Mac (no brew, ever) — they run
# from the minimal `nyckel` image. This shim mounts cwd at the same path so
# `age-keygen -o keys.txt` lands where you'd expect. To seed a host identity:
#
#   mkdir -p ~/.config/sops/age && cd ~/.config/sops/age
#   age-keygen -o keys.txt && chmod 600 keys.txt
#
# (Only the public key is printed; the private key goes straight to the file.)
#

set -e

_TOOL="age-keygen"
_IMAGE="nyckel"

# One place ensures an image is local, for every shim and for primate(): the
# `primate-pull` sibling of this script — the repo's bin/, or ~/.local/bin where
# setup symlinks that whole directory. This used to be ~50 lines copied into
# each of four files, and the copies drifted.
_PP="$(cd -P "$(dirname "$0")" && pwd)/primate-pull"
if [[ ! -x "$_PP" ]]; then
  _PP="$(command -v primate-pull || true)"
fi
if [[ -z "$_PP" ]]; then
  echo "${_TOOL} shim: primate-pull not found; cannot ensure ${_IMAGE} is local." >&2
  exit 1
fi
"$_PP" "$_IMAGE"

_cwd="$(pwd)"

_tty=(-i)
if [[ -t 0 && -t 1 ]]; then
  _tty=(-it)
fi

exec docker run --rm "${_tty[@]}" \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  --volume "${_cwd}:${_cwd}" \
  --workdir "${_cwd}" \
  "${_IMAGE}" "${_TOOL}" "$@"
