#!/usr/bin/env bash
#
# aws — local-first wrapper around the AWS CLI
#
# Uses any real `aws` binary already on PATH if one exists. Otherwise runs
# `aws` inside a `minion` container with:
#   - ~/.aws mounted read-only for credentials
#   - $(pwd) mounted at the same path inside the container (so host
#     absolute paths under cwd work as-is, not just relative paths)
#   - AWS_* env vars forwarded
#
# Forwarding AWS_PROFILE is not enough on its own: with it unset the CLI
# resolves the 'default' profile, so a ~/.aws holding only named profiles fails
# with NoCredentials. When there is exactly one profile and no default, this
# selects it and says so.
#
# Force the container path with: _AWS_FORCE_CONTAINER=1 aws ...
#

set -e

# Profiles present in ~/.aws (config writes "[profile x]", credentials "[x]").
# config's "[sso-session x]" / "[services x]" sections are deliberately skipped.
_aws_profiles() {
  { sed -nE 's/^\[profile ([^]]+)\][[:space:]]*$/\1/p; s/^\[(default)\][[:space:]]*$/\1/p' \
      "$HOME/.aws/config"
    sed -nE 's/^\[([^][:space:]]+)\][[:space:]]*$/\1/p' "$HOME/.aws/credentials"
  } 2>/dev/null | sort -u
}

if [[ -z "${AWS_PROFILE:-}" ]] && ! _aws_profiles | grep -qx default; then
  _only="$(_aws_profiles)"
  if [[ -n "$_only" && "$(printf '%s\n' "$_only" | wc -l)" -eq 1 ]]; then
    export AWS_PROFILE="$_only"
    echo "aws shim: no 'default' AWS profile; using the only one present: ${AWS_PROFILE}" >&2
  fi
fi

# Inode of this shim (follows symlinks). Used to skip ourselves on PATH.
_inode() { ls -Lid "$1" 2>/dev/null | awk '{print $1}'; }
_my_inode="$(_inode "$0")"

_real_aws=""
while IFS= read -r _candidate; do
  if [[ "$(_inode "$_candidate")" != "$_my_inode" ]]; then
    _real_aws="$_candidate"
    break
  fi
done < <(type -aP aws 2>/dev/null)

if [[ -z "$_AWS_FORCE_CONTAINER" && -n "$_real_aws" ]]; then
  exec "$_real_aws" "$@"
fi

# Container fallback.
_aws_mount=()
if [[ -d "$HOME/.aws" ]]; then
  _aws_mount=(--volume "$(cd -P "$HOME/.aws" && pwd):/home/codemonkey/.aws:ro")
fi

_tty=()
if [[ -t 0 ]]; then
  _tty=(-it)
fi

_cwd="$(pwd)"

exec docker run --rm "${_tty[@]}" \
  -e AWS_PAGER="" \
  -e AWS_PROFILE -e AWS_REGION -e AWS_DEFAULT_REGION \
  -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN \
  "${_aws_mount[@]}" \
  --volume "${_cwd}:${_cwd}" \
  --workdir "${_cwd}" \
  --user codemonkey:codemonkey \
  minion aws "$@"
