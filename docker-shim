#!/bin/sh
# docker — the codemonkey Docker-out-of-Docker shim. codemonkey.dockerfile installs this as
# /usr/local/bin/docker, ahead of /usr/bin/docker on PATH. See CLAUDE.md "Docker-out-of-Docker".
#
# Normal path: primate()/primate-session() start the container with --group-add <socket gid>,
# the unprivileged codemonkey user can open /var/run/docker.sock, and this exec's the real CLI
# unchanged (no sudo, no root-owned files).
#
# Fallback: the container was started without that (a bare `docker run`, an older zfuncs, a
# host whose socket gid differs from the one we guessed) and the socket is denied. Then run
# the CLI under the NOPASSWD sudo the image already grants — quietly, so scripts, make and
# agents never see "permission denied" and conclude Docker is unavailable. Nothing on the
# socket is ever chmod'ed or chgrp'ed: on a real Linux host that inode IS the host's socket,
# and changing its group would break the host's docker group.
#
# The fallback preserves the WHOLE environment, deliberately. It used to carry an allowlist of
# docker/compose variable names, which failed twice over:
#   - It silently dropped credentials. `bin/aws`, `bin/sops`, `bin/age`, `bin/age-keygen` and
#     `vault` all pass AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN through
#     `docker run -e VAR` — a flag evaluated by THIS process, so anything sudo already stripped
#     forwards nothing and the containerized tool quietly falls back to ~/.aws or fails with
#     NoCredentials. The ECR login paths (zfuncs' _primate_ensure_image, primates/build-push.sh,
#     primates/manifest-push.sh) do the same with AWS_PROFILE.
#   - It could never be complete. `docker compose` interpolates arbitrary names out of the
#     environment (e.g. the documented `LITELLM_PORT=8889 docker compose up -d`), and no
#     enumerated list can cover names nobody has invented yet.
# And it bought nothing in exchange: this branch is already `sudo -n docker`, i.e. root-equivalent
# host access, so preserving the caller's environment confers no privilege the command does not
# confer on its own. The shim must be TRANSPARENT — a variable it drops fails invisibly, far from
# here, in a tool that reports something else entirely.
#
# Bypass the shim (e.g. to prove the negative) with /usr/bin/docker.

real=/usr/bin/docker
sock=/var/run/docker.sock

case "${DOCKER_HOST:-}" in
  "")       ;;
  unix://*) sock="${DOCKER_HOST#unix://}" ;;
  *)        exec "$real" "$@" ;;          # tcp/ssh daemon — socket perms are irrelevant
esac

if [ "$(id -u)" != 0 ] && [ -S "$sock" ] && [ ! -w "$sock" ] && sudo -n true 2>/dev/null; then
  # Preferred: -E, one flag, everything survives.
  if sudo -n -E true 2>/dev/null; then
    exec sudo -n -E "$real" "$@"
  fi

  # A sudoers policy without SETENV refuses -E. Name every variable that is actually set instead,
  # minus the handful sudo and the shell must own for their own correctness (PATH and LD_*/DYLD_*
  # in particular are the ones an env-preserving sudo is normally protecting).
  keep=$(env 2>/dev/null | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' \
    | grep -Ev '^(PATH|HOME|SHELL|USER|USERNAME|LOGNAME|IFS|ENV|BASH_ENV|CDPATH|PS[1-4]|SUDO_.*|LD_.*|DYLD_.*)$' \
    | tr '\n' ',' | sed 's/,$//')
  if [ -n "$keep" ]; then
    exec sudo -n "--preserve-env=$keep" "$real" "$@"
  fi

  exec sudo -n "$real" "$@"
fi

exec "$real" "$@"
