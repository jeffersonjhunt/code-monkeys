source ${HOME}/.zbase

#
# Perms Fixes
#

if [[ -f /.dockerenv ]]; then
  # Only the workspace bind mount is ours to rewrite. The home volume's own contents are already
  # uid-1000 owned (codemonkey.dockerfile chowns them at build), and ~/.ssh / ~/.aws are HOST
  # credential mounts — a recursive chown there mutates the host's inodes, outside the container.
  # This is an allowlist on purpose: a denylist would have to be remembered every time another
  # mount appears under $HOME, which is the failure mode that produced this bug.
  #
  # Trade accepted knowingly: the old blanket find also repaired root-owned files ANYWHERE under
  # $HOME — files left by `sudo` in the container, a `docker exec -u root` session, or a failed
  # dotfile sync. That repair is gone. The sync case is handled at its source instead
  # (primates/upgrade-home.sh chowns on an EXIT trap, so it cannot leave root-owned files even
  # when it aborts); the others are rare and visible. Restoring a blanket repair would mean
  # re-introducing the denylist this block exists to avoid, so: fix the cause, not the symptom.
  if [[ -d "${HOME}/workspace" ]] && [[ "$(stat -c %U "${HOME}/workspace" 2>/dev/null)" != codemonkey ]]; then
    sudo chown -R codemonkey:codemonkey "${HOME}/workspace"
  fi

  # Docker socket GID fixup for containers started WITHOUT primate()'s --group-add: put
  # codemonkey in the socket's group for future logins (docker exec / newgrp). The current
  # shell is not affected — that is what the /usr/local/bin/docker sudo-fallback shim is for.
  if [[ -S /var/run/docker.sock ]]; then
    SOCK_GID=$(stat -c '%g' /var/run/docker.sock 2>/dev/null)
    if [[ -n "$SOCK_GID" ]] && ! id -G codemonkey | grep -qw "$SOCK_GID"; then
      SOCK_GROUP=$(getent group "$SOCK_GID" | cut -d: -f1)
      if [[ -z "$SOCK_GROUP" ]]; then
        sudo groupadd -g "$SOCK_GID" docker-host 2>/dev/null && SOCK_GROUP=docker-host
      fi
      if [[ -n "$SOCK_GROUP" ]]; then
        sudo usermod -aG "$SOCK_GROUP" codemonkey 2>/dev/null || true
      fi
    fi
  fi
fi

#
# End Perms Fixes
#

if [[ "$TAINTED_BUILD" = "true" ]]; then
  printf '\n⚠️  WARNING: This image was built with UNSAFE_SSL=true (tainted build)\n'
  printf '   SSL certificate verification was disabled during image construction.\n\n'
fi

#
# Conda Init (for miniforge3-based images with persistent home volumes)
#
if [[ -f /.dockerenv ]] && [[ -f /opt/miniforge3/bin/conda ]]; then
  __conda_setup="$('/opt/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "/opt/miniforge3/etc/profile.d/conda.sh" ]; then
      . "/opt/miniforge3/etc/profile.d/conda.sh"
    else
      export PATH="/opt/miniforge3/bin:$PATH"
    fi
  fi
  unset __conda_setup
  if [[ -f /opt/miniforge3/.default-env ]]; then
    conda activate "$(cat /opt/miniforge3/.default-env)"
  else
    conda deactivate
  fi
fi

