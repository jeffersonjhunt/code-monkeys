#!/usr/bin/env bash
#
# pre-commit — warn if any vault is stale, or if vault credentials are stale-dated
#
# Both checks are advisory: this hook never blocks a commit.
#

REPO_DIR="$(git rev-parse --show-toplevel)"

# --- Stale vault ---

if stale=$("$REPO_DIR/vault" status --local 2>/dev/null | grep "STALE"); then
  echo ""
  echo "WARNING: vault may be stale:"
  echo "$stale"
  echo "  Run './vault lock --keep' to re-encrypt into the hemlighet clone, then commit+push there."
  echo ""
fi

# --- Vault entry age (monthly rotation) ---
#
# Age comes from the vault itself: the last commit date of each encrypted file
# in the hemlighet clone. Re-locking a rotated credential and committing it is
# what resets the clock — there is nothing to self-report. Commit dates are used
# rather than mtimes because a fresh clone would make every entry look new.
#
# Only credential-bearing items are checked; 'face' and 'gitconfig' live in the
# vault but are not things you rotate.

ROTATION_DAYS=30
ROTATION_ITEMS="ssh env aws"

# Mirrors vault's resolution: explicit override, then the XDG data dir, then a
# legacy ~/hemlighet clone if one still exists.
HL="${VAULT_HEMLIGHET:-}"
if [[ -z "$HL" ]]; then
  HL="${XDG_DATA_HOME:-$HOME/.local/share}/hemlighet"
  [[ ! -d "$HL/.git" && -d "$HOME/hemlighet/.git" ]] && HL="$HOME/hemlighet"
fi
HL_SUB="code-monkeys/personal"

if [[ -d "$HL/.git" && -d "$HL/$HL_SUB" ]]; then
  now=$(date +%s)
  overdue=""

  while IFS= read -r sops; do
    rel="${sops#"$HL"/}"                  # path relative to the clone
    entry="${rel#"$HL_SUB"/}"             # e.g. env.sops, ssh/id_ed25519.sops
    entry="${entry%.sops}"                # e.g. env, ssh/id_ed25519
    item="${entry%%/*}"                   # top-level vault item

    case " $ROTATION_ITEMS " in
      *" $item "*) ;;
      *) continue ;;
    esac

    # No commit yet means locked-but-unpushed; the stale-vault check owns that.
    ts=$(git -C "$HL" log -1 --format=%ct -- "$rel" 2>/dev/null) || continue
    [[ -n "$ts" ]] || continue

    days=$(( (now - ts) / 86400 ))
    if (( days > ROTATION_DAYS )); then
      overdue+="$(printf '%5d  %s' "$days" "$entry")"$'\n'
    fi
  done < <(find "$HL/$HL_SUB" -type f -name '*.sops' 2>/dev/null)

  if [[ -n "$overdue" ]]; then
    echo ""
    echo "WARNING: vault credentials not rotated in over ${ROTATION_DAYS} days:"
    echo "  days  entry"
    printf '%s' "$overdue" | sort -rn | head -10 | sed 's/^/  /'
    echo "  Rotate at the source, then: ./vault lock --keep && commit+push $HL"
    echo ""
  fi
fi

exit 0
