#!/bin/bash
#
# setup — configure a new box (Linux, MacOS, Windows WSL2)
#
# Usage: setup [--dry-run] [--uninstall] [--help]
#

set -euo pipefail

SRC="$(cd "$(dirname "$0")" && pwd)"

# --- Configuration ---

DOT_LINKS="ssh aws gitconfig gitignore toprc tmux.conf vimrc zaliases zbase zfuncs zprofile"
DIR_LINKS="fastfetch::config jjh.zsh-theme::oh-my-zsh/custom/themes"

# Individual items linked INTO an existing directory under $HOME: "<path-under-SRC>::<parent>"
# links to $HOME/.<parent>/<basename>.
#
# This exists because ~/.claude cannot be a symlink. It is Claude Code's live state directory
# (credentials, history, projects, daemon, cache), so it must stay a real directory that we link
# individual files *into*. DIR_LINKS used to carry a `claude::claude` entry, but its rule is
# "$HOME/.<parent>/<name>" — which produced ~/.claude/claude -> repo/claude, a path nothing reads.
# The settings and commands never actually reached ~/.claude from setup at all.
CHILD_LINKS="claude/settings.json::claude claude/commands::claude"
BIN_DIR="${HOME}/.local/bin"

# ECR credential helper: the fleet registry whose pulls/pushes authenticate from ~/.aws via
# docker-credential-ecr-login (no `docker login`, no credential store). CODEMONKEYS_ECR overrides.
ECR_REGISTRY_DEFAULT="521147433280.dkr.ecr.us-east-1.amazonaws.com"
# macOS has no apt and these boxes carry no Homebrew (and AWS retired the public binary URLs), so the
# Mac binary is cross-built from source in a Go container. Linux installs the stock apt package.
ECR_HELPER_VERSION="0.12.0"
GIT_REPOS=(
  "https://github.com/zsh-users/zsh-autosuggestions.git::${HOME}/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
  "https://github.com/zsh-users/zsh-completions.git::${HOME}/.oh-my-zsh/custom/plugins/zsh-completions"
  "https://github.com/zsh-users/zsh-syntax-highlighting.git::${HOME}/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"
)

# --- Options ---

DRY_RUN=false
UNINSTALL=false

# --- Functions ---

usage() {
  cat <<EOF
Usage: setup [OPTIONS]

Set up a new box with dotfiles and shell configuration.

Options:
  --dry-run     Show what would be done without making changes
  --uninstall   Remove symlinks, cloned repos, and marker file
  --help        Show this help message
EOF
}

detect_os() {
  case "$(uname -s)" in
    Darwin) echo "MacOS" ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        echo "WSL"
      else
        echo "Linux"
      fi
      ;;
    *) echo "Unknown" ;;
  esac
}

preflight() {
  echo "Preflight check..."
  local missing=()
  for cmd in zsh curl git chsh; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf "  %-8s ok\n" "$cmd"
    else
      printf "  %-8s MISSING\n" "$cmd"
      missing+=("$cmd")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo ""
    echo "ERROR: missing required commands: ${missing[*]}"
    echo "Install them and re-run setup."
    exit 1
  fi

  local optional=()
  for cmd in aws fastfetch; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf "  %-8s ok\n" "$cmd"
    else
      printf "  %-8s WARNING: not found — some features will be unavailable\n" "$cmd"
      optional+=("$cmd")
    fi
  done
  echo ""
}

run() {
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [dry-run] $*"
  else
    echo "  $*"
    "$@"
  fi
}

create_dot_links() {
  echo "Creating dotfile symlinks..."
  for name in ${DOT_LINKS}; do
    local target="${HOME}/.${name}"
    local source="${SRC}/${name}"

    if [[ ! -e "$source" && ! -L "$source" ]]; then
      echo "  skip: ${source} not found (available after ./vault unlock)"
      continue
    fi

    if [[ -e "$target" || -L "$target" ]]; then
      echo "  skip: ${target} already exists"
    else
      run ln -s "$source" "$target"
    fi
  done
}

remove_dot_links() {
  echo "Removing dotfile symlinks..."
  for name in ${DOT_LINKS}; do
    local target="${HOME}/.${name}"

    if [[ -L "$target" ]]; then
      run rm "$target"
    else
      echo "  skip: ${target} is not a symlink"
    fi
  done
}

create_dir_links() {
  echo "Creating directory symlinks..."
  for entry in ${DIR_LINKS}; do
    local src_name="${entry%%::*}"
    local parent_dir="${entry##*::}"
    local target="${HOME}/.${parent_dir}/${src_name}"
    local source="${SRC}/${src_name}"

    if [[ ! -d "${HOME}/.${parent_dir}" ]]; then
      run mkdir -p "${HOME}/.${parent_dir}"
    fi

    if [[ -e "$target" || -L "$target" ]]; then
      echo "  skip: ${target} already exists"
    else
      run ln -s "$source" "$target"
    fi
  done
}

remove_dir_links() {
  echo "Removing directory symlinks..."
  for entry in ${DIR_LINKS}; do
    local src_name="${entry%%::*}"
    local parent_dir="${entry##*::}"
    local target="${HOME}/.${parent_dir}/${src_name}"

    if [[ -L "$target" ]]; then
      run rm "$target"
    else
      echo "  skip: ${target} is not a symlink"
    fi
  done

  # Clean up the link the old `claude::claude` DIR_LINKS entry used to create. Harmless, but it
  # is ours and it points at the repo, so uninstall should take it with us.
  if [[ -L "${HOME}/.claude/claude" ]]; then
    echo "  (legacy) removing ${HOME}/.claude/claude"
    run rm "${HOME}/.claude/claude"
  fi
}

create_child_links() {
  echo "Linking items into existing \$HOME directories..."
  for entry in ${CHILD_LINKS}; do
    local src_path="${entry%%::*}"
    local parent_dir="${entry##*::}"
    local source="${SRC}/${src_path}"
    local target="${HOME}/.${parent_dir}/$(basename "$src_path")"

    if [[ ! -e "$source" ]]; then
      echo "  skip: ${source} does not exist"
      continue
    fi

    # The parent must be a real directory we can link into — never replace it.
    if [[ ! -d "${HOME}/.${parent_dir}" ]]; then
      run mkdir -p "${HOME}/.${parent_dir}"
    fi

    if [[ -L "$target" ]]; then
      echo "  skip: ${target} already linked"
    elif [[ -e "$target" ]]; then
      # A real file/dir is already there (e.g. a copy made by hand, or settings you wrote
      # yourself). Do NOT clobber it — say what to do instead.
      echo "  skip: ${target} exists and is not a symlink"
      echo "        (remove it if you want setup to manage it: rm -rf ${target})"
    else
      run ln -s "$source" "$target"
    fi
  done
}

remove_child_links() {
  echo "Removing \$HOME directory item links..."
  for entry in ${CHILD_LINKS}; do
    local src_path="${entry%%::*}"
    local parent_dir="${entry##*::}"
    local target="${HOME}/.${parent_dir}/$(basename "$src_path")"

    if [[ -L "$target" ]]; then
      run rm "$target"
    else
      echo "  skip: ${target} is not a symlink"
    fi
  done
}

create_bin_links() {
  echo "Creating bin/ shim symlinks..."
  if [[ ! -d "${SRC}/bin" ]]; then
    echo "  skip: ${SRC}/bin not found"
    return
  fi

  if [[ ! -d "$BIN_DIR" ]]; then
    run mkdir -p "$BIN_DIR"
  fi

  for source in "${SRC}/bin/"*; do
    [[ -e "$source" ]] || continue
    local name
    name="$(basename "$source")"
    local target="${BIN_DIR}/${name}"

    if [[ -e "$target" || -L "$target" ]]; then
      echo "  skip: ${target} already exists"
    else
      run ln -s "$source" "$target"
    fi
  done
}

remove_bin_links() {
  echo "Removing bin/ shim symlinks..."
  if [[ ! -d "${SRC}/bin" ]]; then
    return
  fi

  for source in "${SRC}/bin/"*; do
    [[ -e "$source" ]] || continue
    local name
    name="$(basename "$source")"
    local target="${BIN_DIR}/${name}"

    if [[ -L "$target" ]]; then
      run rm "$target"
    else
      echo "  skip: ${target} is not a symlink"
    fi
  done
}

install_zshrc() {
  echo "Installing zshrc..."
  local target="${HOME}/.zshrc"
  local source="${SRC}/zbase"

  if [[ -e "$target" ]]; then
    echo "  skip: ${target} already exists"
  else
    run cp "$source" "$target"
  fi
}

remove_zshrc() {
  echo "Removing zshrc..."
  local target="${HOME}/.zshrc"

  if [[ -f "$target" ]]; then
    run rm "$target"
  else
    echo "  skip: ${target} not found"
  fi
}

clone_repos() {
  echo "Cloning Oh-My-Zsh plugin repos..."
  for entry in "${GIT_REPOS[@]}"; do
    local repo="${entry%%::*}"
    local dest="${entry##*::}"

    if [[ -d "$dest" ]]; then
      echo "  skip: ${dest} already exists"
    else
      run git clone "$repo" "$dest"
    fi
  done
}

remove_repos() {
  echo "Removing Oh-My-Zsh plugin repos..."
  for entry in "${GIT_REPOS[@]}"; do
    local dest="${entry##*::}"

    if [[ -d "$dest" ]]; then
      run rm -rf "$dest"
    else
      echo "  skip: ${dest} not found"
    fi
  done
}

setup_macos() {
  echo "Setting up macOS key bindings..."
  local source="${SRC}/Library/KeyBindings"
  local target="${HOME}/Library/KeyBindings"

  if [[ ! -d "$source" ]]; then
    echo "  skip: ${source} not found"
    return
  fi

  if [[ -d "$target" ]]; then
    echo "  skip: ${target} already exists"
  else
    run mkdir -p "${HOME}/Library"
    run cp -a "$source" "$target"
  fi
}

remove_macos() {
  echo "Removing macOS key bindings..."
  local target="${HOME}/Library/KeyBindings"

  if [[ -d "$target" ]]; then
    run rm -rf "$target"
  else
    echo "  skip: ${target} not found"
  fi
}

install_ohmyzsh() {
  echo "Checking Oh-My-Zsh..."
  if [[ -f "${HOME}/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    echo "  skip: Oh-My-Zsh already installed"
  else
    echo "  installing Oh-My-Zsh..."
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] install oh-my-zsh"
    else
      sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
      if [[ ! -f "${HOME}/.oh-my-zsh/oh-my-zsh.sh" ]]; then
        echo "  ERROR: Oh-My-Zsh installation failed."
        exit 1
      fi
      # remove the default .zshrc that oh-my-zsh creates — ours replaces it
      rm -f "${HOME}/.zshrc"
    fi
  fi

  local current_shell
  current_shell=$(basename "${SHELL:-}")
  if [[ "$current_shell" != "zsh" ]]; then
    local zsh_path
    zsh_path=$(command -v zsh)
    echo "  setting default shell to zsh..."
    run chsh -s "$zsh_path"
  fi
}

install_hooks() {
  if [[ ! -d "${SRC}/hooks" || ! -d "${SRC}/.git/hooks" ]]; then
    return
  fi

  echo "Installing git hooks..."
  for hook in "${SRC}"/hooks/*; do
    local hook_name
    hook_name="$(basename "$hook")"
    run cp "$hook" "${SRC}/.git/hooks/${hook_name}"
    run chmod +x "${SRC}/.git/hooks/${hook_name}"
  done
}

install_skills() {
  if [[ ! -f "${SRC}/007/skills/Makefile" ]]; then
    echo "  skip: 007/skills not found"
    return
  fi

  echo "Installing agent skills..."
  run make -C "${SRC}/007/skills" install
}

remove_skills() {
  if [[ ! -f "${SRC}/007/skills/Makefile" ]]; then
    return
  fi

  echo "Removing agent skills..."
  run make -C "${SRC}/007/skills" uninstall
}

# ECR credential helper. Installs docker-credential-ecr-login and a `credHelpers` entry so that
# `docker pull`/`push` of codemonkeys/* images authenticate to ECR straight from ~/.aws — no
# `docker login`, no OS credential store/keychain (which is what kept breaking). Never fatal: a
# failure here warns and setup continues; primate-pull reports clearly if the helper is missing.
install_ecr_helper() {
  echo "Installing ECR credential helper..."
  local reg="${CODEMONKEYS_ECR:-$ECR_REGISTRY_DEFAULT}"

  if command -v docker-credential-ecr-login >/dev/null 2>&1; then
    echo "  skip: docker-credential-ecr-login already on PATH"
  elif [[ "$OS" == "Linux" || "$OS" == "WSL" ]]; then
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] sudo apt-get install -y amazon-ecr-credential-helper"
    elif ! { sudo apt-get update -qq && sudo apt-get install -y amazon-ecr-credential-helper; }; then
      echo "  WARNING: could not apt-install amazon-ecr-credential-helper — install it manually." >&2
    fi
  elif [[ "$OS" == "MacOS" ]]; then
    install_ecr_helper_macos || echo "  WARNING: ECR helper not installed (see above)." >&2
  fi

  ensure_credhelper_config "$reg"
}

# macOS binary: cross-built from source in a Go container (needs Docker running), dropped in
# ~/.local/bin (no sudo — same place as our shims).
install_ecr_helper_macos() {
  local arch out ver="$ECR_HELPER_VERSION"
  case "$(uname -m)" in arm64|aarch64) arch=arm64 ;; *) arch=amd64 ;; esac
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [dry-run] docker run golang ... build docker-credential-ecr-login -> ${BIN_DIR}/"
    return 0
  fi
  if ! docker version >/dev/null 2>&1; then
    echo "  WARNING: Docker is not running — cannot build the ECR helper. Start Docker and re-run setup." >&2
    return 1
  fi
  echo "  building docker-credential-ecr-login ${ver} (darwin/${arch}) in a Go container..."
  # Stream the built binary out over the container's stdout rather than bind-mounting an output dir.
  # A bind mount resolves on the Docker Desktop VM and so depends on its file-sharing list; stdout is
  # client-streamed and always works (same reason `docker build`/`docker cp` do). go install's own
  # chatter is sent to stderr so only the binary bytes land in the file.
  local tmpf; tmpf="$(mktemp)"
  if docker run --rm -e CGO_ENABLED=0 -e GOOS=darwin -e "GOARCH=${arch}" golang:1.24 \
       sh -c "go install github.com/awslabs/amazon-ecr-credential-helper/ecr-login/cli/docker-credential-ecr-login@v${ver} 1>&2 && cat /go/bin/darwin_${arch}/docker-credential-ecr-login" \
       > "$tmpf" && [ -s "$tmpf" ]; then
    mkdir -p "$BIN_DIR"
    install -m 0755 "$tmpf" "${BIN_DIR}/docker-credential-ecr-login"
    echo "  installed ${BIN_DIR}/docker-credential-ecr-login"
    rm -f "$tmpf"
  else
    rm -f "$tmpf"
    return 1
  fi
}

# Merge a credHelpers entry into ~/.docker/config.json (never clobber other docker CLI state).
ensure_credhelper_config() {
  local reg="$1" cfg="${HOME}/.docker/config.json" tmp
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [dry-run] merge credHelpers[${reg}]=ecr-login into ${cfg}"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "  WARNING: jq not found — add '\"credHelpers\":{\"${reg}\":\"ecr-login\"}' to ${cfg} by hand." >&2
    return 0
  fi
  mkdir -p "${HOME}/.docker"
  [[ -s "$cfg" ]] || echo '{}' > "$cfg"
  tmp="$(mktemp)"
  if jq --arg reg "$reg" '.credHelpers = ((.credHelpers // {}) + {($reg):"ecr-login"})' "$cfg" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$cfg"
    echo "  credHelpers[${reg}]=ecr-login in ${cfg}"
  else
    rm -f "$tmp"
    echo "  WARNING: could not update ${cfg} — add the credHelpers entry by hand." >&2
  fi
}

remove_ecr_helper() {
  echo "Removing ECR credential helper config..."
  local reg="${CODEMONKEYS_ECR:-$ECR_REGISTRY_DEFAULT}" cfg="${HOME}/.docker/config.json" tmp
  # Only the Mac binary we dropped in ~/.local/bin; leave an apt-installed Linux package in place.
  if [[ -f "${BIN_DIR}/docker-credential-ecr-login" && ! -L "${BIN_DIR}/docker-credential-ecr-login" ]]; then
    run rm -f "${BIN_DIR}/docker-credential-ecr-login"
  fi
  if [[ "$DRY_RUN" == false && -s "$cfg" ]] && command -v jq >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg reg "$reg" 'if has("credHelpers") then .credHelpers |= del(.[$reg]) | (if .credHelpers == {} then del(.credHelpers) else . end) else . end' \
          "$cfg" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$cfg"
    else
      rm -f "$tmp"
    fi
  fi
}

# --- Parse args ---

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)   DRY_RUN=true; shift ;;
    --uninstall) UNINSTALL=true; shift ;;
    --help)      usage; exit 0 ;;
    *)           echo "Unknown option: $1"; usage; exit 1 ;;
  esac
done

# --- Main ---

OS=$(detect_os)
echo "OS: ${OS}"
echo "Source: ${SRC}"
echo ""

if [[ "$UNINSTALL" == true ]]; then
  [[ "$DRY_RUN" == true ]] && echo "=== DRY RUN (uninstall) ==="

  remove_dot_links
  remove_dir_links
  remove_child_links
  remove_bin_links
  remove_ecr_helper
  remove_zshrc
  remove_repos
  remove_skills
  [[ "$OS" == "MacOS" ]] && remove_macos

  if [[ "$DRY_RUN" == false ]]; then
    rm -f "${SRC}/.configured"
  fi

  echo ""
  echo "Uninstall complete."
else
  if [[ -f "${SRC}/.configured" ]]; then
    echo "Already configured (${SRC}/.configured exists)."
    echo "Run with --uninstall first to reconfigure."
    exit 1
  fi

  [[ "$DRY_RUN" == true ]] && echo "=== DRY RUN (install) ==="

  preflight
  install_ohmyzsh
  create_dot_links
  create_dir_links
  create_child_links
  create_bin_links
  install_zshrc
  clone_repos
  [[ "$OS" == "MacOS" ]] && setup_macos

  install_ecr_helper

  install_hooks

  install_skills

  if [[ "$DRY_RUN" == false ]]; then
    touch "${SRC}/.configured"
    echo ""
    if [[ ! -e "${SRC}/ssh" || ! -f "${SRC}/env" ]]; then
      echo "Vault items locked. Run: ./vault unlock  (needs a hemlighet clone in ~/.local/share + this machine's age key)"
    fi
    echo "Setup complete. Restart your shell or run: source ~/.zshrc"
  else
    echo ""
    echo "Dry run complete. No changes were made."
  fi
fi

# Fin
