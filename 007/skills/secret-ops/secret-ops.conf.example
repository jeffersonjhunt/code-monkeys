# secret-ops.conf.example — copy to ~/.config/secret-ops.conf and fill in.
#
# This .example (placeholders only) is the ONLY secret-ops config in the public repo. The real file
# is private to each machine and MUST NOT be committed — keep it at ~/.config/secret-ops.conf, or
# point $SECRET_OPS_CONF at it. The scripts read env vars first, then this file if present.

# The host where SOPS/age, the hemlighet clone, and its git push creds all live. hemlighet edits
# originate here and are pushed; other machines only pull.
SECRET_HOST=

# The ssh user on that host (needs the age key at ~/.config/sops/age/keys.txt and push creds).
SECRET_USER=

# The hemlighet clone on that host. Optional — defaults to the published $HOME/.local/share/hemlighet.
# HEMLIGHET_DIR=$HOME/.local/share/hemlighet

# The code-monkeys checkout on that host, if you need to reference decrypted working copies by path.
# Optional.
# CHECKOUT_DIR=
