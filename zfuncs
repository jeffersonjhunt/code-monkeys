# load env file into current shell as exported variables
function setenv() {
  local __ENV_FILE="${1:-${${(%):-%x}:A:h}/env}"
  if [[ ! -f "$__ENV_FILE" ]]; then
    echo "env file not found: ${__ENV_FILE}"
    return 1
  fi
  set -a
  source "$__ENV_FILE"
  set +a
  echo "loaded: ${__ENV_FILE}"
}

# Ensure <image>:latest exists locally; if not, pull it from the fleet ECR and retag to the bare
# local name the primate functions expect. Lets `primate <name>` work on a host that has never
# built the image.
#
# The pull itself lives in bin/primate-pull, which every shim (bin/aws, bin/sops, bin/age,
# bin/age-keygen) and `vault` also call. This used to be its own copy of that logic — the weakest
# of the five: it silenced both the token fetch and the login, so a credentials problem reported
# itself as "could not be pulled from ECR". Nothing here now but finding the script.
function _primate_ensure_image() {
  local __img=$1
  local __pp="${${(%):-%x}:A:h}/bin/primate-pull"
  # Inside a primate ~/.zfuncs is a standalone copy with no sibling bin/; upgrade-home.sh puts
  # primate-pull on PATH there instead.
  [[ -x "$__pp" ]] || __pp=$(command -v primate-pull)
  if [[ -z "$__pp" ]]; then
    echo "  ERROR: primate-pull not found; cannot ensure ${__img} is local." >&2
    echo "         Run ./setup on this host, or build it: cd primates && make ${__img}.build" >&2
    return 1
  fi
  "$__pp" "$__img"
}

# A first run has no <image>-home volume yet, so docker creates one and seeds it from the image —
# and the images ship PLACEHOLDER configs. opencode's baked opencode.json names LITELLM_HOST and a
# model alias the router stopped serving, because the real file is gitignored and lives encrypted in
# hemlighet; the claude primate's settings.json and commands are in the same position. Nothing on
# the `primate` path ever replaced them, so a clean install could not produce a working opencode:
# you had to already know to run primate-upgrade, and blowing the volumes away to start fresh made
# it worse rather than better. First run now syncs.
#
# Never blocks the launch. Every failure below warns and returns 0 — a stale config is worth a
# warning, not a refusal to start the container you asked for.
function _primate_first_run_sync() {
  local __img=$1
  local __vol="${__img}-home"
  # The volume existing IS the "not a first run" test, which also makes this a no-op on the
  # re-attach paths without their needing to know about it.
  docker volume inspect "$__vol" &>/dev/null && return 0

  local __repo="${${(%):-%x}:A:h}"
  # Inside a primate ~/.zfuncs is a standalone copy with no sibling primates/; and even where a repo
  # checkout is visible, --volume "$__repo:..." would be resolved by the DAEMON HOST against a
  # container path and arrive empty. primate-upgrade refuses inside a primate for the same reason.
  if [[ -f /.dockerenv || ! -f "${__repo}/primates/upgrade-home.sh" ]]; then
    echo "  first run of ${__img}: no host repo checkout here, so the image's default configs stand." >&2
    echo "  Sync them from the host with: primate-upgrade ${__img}" >&2
    return 0
  fi

  echo "first run of ${__img}: seeding ${__vol} from the image, then syncing repo configs into it"

  # Seed first. Docker copies image content into a volume only while that volume is EMPTY at mount
  # time, so writing dotfiles in ahead of this would cost us oh-my-zsh, the conda init and
  # everything else the image bakes into $HOME. `docker create` triggers the copy without starting
  # anything, so entrypoints and CMDs do not come into it.
  local __cid
  if ! __cid=$(docker create --volume "${__vol}:/home/codemonkey" "${__img}:latest" true 2>/dev/null); then
    echo "  WARNING: could not seed ${__vol} from ${__img}; starting with image defaults." >&2
    return 0
  fi
  docker rm -f "$__cid" >/dev/null 2>&1

  if ! docker image inspect codemonkey:latest >/dev/null 2>&1; then
    if ! _primate_ensure_image codemonkey; then
      echo "  WARNING: codemonkey:latest unavailable, so configs were not synced." >&2
      echo "  Retry later with: primate-upgrade ${__img}" >&2
      return 0
    fi
  fi

  # The same call primate-upgrade makes, against the same one copy of the sync logic.
  if ! docker run --rm \
    --env "PRIMATE=${__img}" \
    --volume "${__repo}:/opt/user-jhunt:ro" \
    --volume "${__vol}:/home/codemonkey" \
    codemonkey:latest bash /opt/user-jhunt/primates/upgrade-home.sh; then
    echo "  WARNING: config sync failed; ${__vol} holds the image defaults." >&2
    echo "  Retry with: primate-upgrade ${__img}" >&2
  fi
  return 0
}

# Refuse to hand a container the whole home directory. The workspace mount is $(pwd), so running
# `primate minion` from ~ puts .ssh, .aws, .docker and every other dotfile at /home/codemonkey/
# workspace, read-write. Almost always a mistake, and a quiet one; --allow-home is there for when
# it is not. Called by primate() and primate-session() so the wording exists once.
function _primate_workspace_guard() {
  local __img=$1 __fn=$2
  [[ "${PWD:A}" == "${HOME:A}" ]] || return 0
  echo "${__fn}: refusing to mount \$HOME (${HOME}) as the workspace." >&2
  echo "  The whole home dir would land at /home/codemonkey/workspace, read-write." >&2
  echo "  Run from a project dir, or:" >&2
  echo "    ${__fn} ${__img} --no-workspace   # no workspace mount at all" >&2
  echo "    ${__fn} ${__img} --allow-home     # mount \$HOME anyway" >&2
  return 1
}

# The primate roster, read off the dockerfiles that define it: codemonkey (whose dockerfile lives
# at the repo root) plus every primates/<name>.dockerfile, resolved relative to this file. The
# dockerfiles ARE the roster — anything else is a second copy of a list already on disk, and a copy
# is what drifted. One name per line.
function _primate_roster() {
  local __repo="${${(%):-%x}:A:h}" __f
  local __found=("${__repo}"/primates/*.dockerfile(N))
  # No dockerfiles means this is not a repo checkout — inside a primate ~/.zfuncs is a copy, so the
  # sibling primates/ does not exist. Return nothing rather than the bare `codemonkey` the glob
  # would leave behind: a one-item completion list reads as the whole roster, which is worse than
  # an empty one. Callers treat a non-zero return as "no roster here" and offer nothing.
  (( $#__found )) || return 1
  print -r -- codemonkey
  for __f in "${__found[@]}"; do
    print -r -- "${${__f:t}%.dockerfile}"
  done
}

# gid to --group-add alongside the /var/run/docker.sock mount so the unprivileged codemonkey
# user can open the socket without anyone touching its perms (mirrors bin/spark-bench).
# Linux: the socket's real group (the host's `docker` group, or 0 inside a Docker Desktop VM).
# macOS: the host-side stat is meaningless — Docker Desktop's VM presents the socket to
# containers as root:root 660 — so the answer is always 0. --group-add 0 grants only the root
# *group* (the socket's rw group bit), not root privileges.
function _primate_docker_gid() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo 0
  else
    stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0
  fi
}

# starts a primate container with a persistent home volume
function primate() {

  local __NO_WORKSPACE=false
  local __ALLOW_HOME=false
  local __args=()
  for arg in "$@"; do
    if [[ "$arg" == "--no-workspace" ]]; then
      __NO_WORKSPACE=true
    elif [[ "$arg" == "--allow-home" ]]; then
      __ALLOW_HOME=true
    else
      __args+=("$arg")
    fi
  done
  set -- "${__args[@]}"

  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate <image> [--no-workspace] [--allow-home] [docker args...]"
    return 1
  fi

  local __IMAGE=$1
  shift

  # Before the pull: refusing after a 3 GB download helps nobody.
  if [[ "$__NO_WORKSPACE" == false && "$__ALLOW_HOME" == false ]]; then
    _primate_workspace_guard "$__IMAGE" primate || return 1
  fi

  _primate_ensure_image "$__IMAGE" || return 1
  _primate_first_run_sync "$__IMAGE"

  # HOST_* carry the host-side path of each shared dir into the container: bind mounts made
  # from inside a primate resolve on the daemon host, so `docker run -v` / compose volumes
  # need these paths, not the container's (see `hostpath` and CLAUDE.md Docker-out-of-Docker).
  local __WORKSPACE_MOUNT=()
  if [[ "$__NO_WORKSPACE" == false ]]; then
    local __HOST_WS="$(pwd)"
    __WORKSPACE_MOUNT=(--volume "${__HOST_WS}:/home/codemonkey/workspace" --env "HOST_WORKSPACE=${__HOST_WS}")
  fi

  local __ZFUNCS_DIR="${${(%):-%x}:A:h}"
  local __ENV_FILE="${__ZFUNCS_DIR}/env"
  local __ENV_FILE_MOUNT=()
  if [[ -f "$__ENV_FILE" ]]; then
    __ENV_FILE_MOUNT=(--env-file "$__ENV_FILE")
  fi

  echo "starting ${__IMAGE} with volume ${__IMAGE}-home"

  local __CMD=(zsh)
  local __ENTRYPOINT=$(docker inspect --format='{{len .Config.Entrypoint}}' "${__IMAGE}:latest" 2>/dev/null)
  if [[ "$__ENTRYPOINT" -gt 0 ]]; then
    __CMD=()
  fi

  local __GPU_OPTS=()
  if [[ "$(uname -r)" == *-nvidia ]]; then
    __GPU_OPTS=(--gpus all)
  fi

  local __PORT_OPTS=()
  local __PORTS=$(docker inspect --format='{{range $p, $_ := .Config.ExposedPorts}}{{$p}} {{end}}' "${__IMAGE}:latest" 2>/dev/null)
  for __PORT in ${=__PORTS}; do
    __PORT_OPTS+=(-p "${__PORT%/*}:${__PORT%/*}")
  done

  local __SSH_MOUNT=()
  if [[ -d ~/.ssh ]]; then
    local __HOST_SSH="$(cd -P ~/.ssh && pwd)"
    __SSH_MOUNT=(--volume "${__HOST_SSH}:/home/codemonkey/.ssh" --env "HOST_SSH_DIR=${__HOST_SSH}")
  fi

  local __AWS_MOUNT=()
  if [[ -d ~/.aws ]]; then
    local __HOST_AWS="$(cd -P ~/.aws && pwd)"
    __AWS_MOUNT=(--volume "${__HOST_AWS}:/home/codemonkey/.aws" --env "HOST_AWS_DIR=${__HOST_AWS}")
  fi

  local __DOCKER_MOUNT=()
  if [[ -S /var/run/docker.sock ]]; then
    __DOCKER_MOUNT=(--volume /var/run/docker.sock:/var/run/docker.sock --group-add "$(_primate_docker_gid)")
  fi

  # Labelled so it can be found by asking docker, the way session containers already are. A
  # foreground primate used to carry no label at all, which left `primate` containers identifiable
  # only by matching their image against the roster — a guess, and the guess is what once let
  # primate-session-kill remove the wrong container. primate.managed is on both launchers so one
  # filter finds every primate; primate.session still tells the two kinds apart.
  docker run --rm -it \
    --label primate.managed \
    --label "primate.image=${__IMAGE}" \
    --hostname "${__IMAGE}" \
    "${__ENV_FILE_MOUNT[@]}" \
    "${__GPU_OPTS[@]}" \
    "${__PORT_OPTS[@]}" \
    "${__SSH_MOUNT[@]}" \
    "${__AWS_MOUNT[@]}" \
    "${__DOCKER_MOUNT[@]}" \
    "${__WORKSPACE_MOUNT[@]}" \
    --volume ${__IMAGE}-home:/home/codemonkey \
    --user=codemonkey:codemonkey \
    $@ \
    ${__IMAGE} "${__CMD[@]}"
}

function _primate() {
  # Every primate, not just the locally-built ones — _primate_ensure_image pulls anything missing
  # from ECR on demand, and the ECR repo names under codemonkeys/* match the dockerfile names.
  # Computed inside the function, so sourcing zfuncs costs nothing.
  local known_primates=(${(f)"$(_primate_roster)"})
  # Kept beside the functions' own flag parsing: a flag the completer does not know about is a
  # flag you cannot discover, which is what --allow-home was between being added and this.
  local __opts=(
    '--no-workspace[do not mount the current directory as the workspace]'
    '--allow-home[permit $HOME as the workspace mount (refused by default)]'
  )

  if (( CURRENT == 2 )); then
    _describe 'primate image' known_primates
    return
  fi

  # primate-session's third word is an optional session name, and naming one that already exists
  # re-attaches to it — so offer the live ones here. `primate` has no such argument.
  if (( CURRENT == 3 )) && [[ "${words[1]}" == "primate-session" ]]; then
    local __live=(${(f)"$(_primate_session_names)"})
    (( $#__live )) && _describe 'existing session (re-attaches)' __live
  fi

  _values 'options' "${__opts[@]}"
}
compdef _primate primate

# The primates that actually have a home volume to upgrade, plus the sweep. Derived from the
# volumes that exist intersected with the dockerfile roster — the same pair primate-upgrade --all
# intersects, and for the same reason: a stray <something>-home volume is not a primate.
function _primate_upgrade() {
  local __roster=(${(f)"$(_primate_roster)"}) __vol __name
  local __have=()
  for __vol in ${(f)"$(docker volume ls --format '{{.Name}}' 2>/dev/null)"}; do
    [[ "$__vol" == *-home ]] || continue
    __name="${__vol%-home}"
    (( ${__roster[(I)$__name]} )) && __have+=("$__name")
  done
  (( $#__have )) && _describe 'primate with a home volume' __have
  local __opts=('--all:every primate home volume that exists')
  _describe 'option' __opts
}
compdef _primate_upgrade primate-upgrade

function primate-upgrade() {
  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-upgrade <image> [image...]"
    echo "       primate-upgrade --all"
    return 1
  fi

  # Refuse inside a container. This upgrades <image>-home volumes, and the one belonging to the
  # primate you are sitting in IS your $HOME right now — it would overwrite .zshrc/.zfuncs/.zbase
  # under a live shell and chown -R your home while you are in it. There is no version of that
  # worth supporting, so it is not translated, worked around, or made to function: it stops here.
  if [[ -f /.dockerenv ]]; then
    echo "primate-upgrade: cannot run from inside a primate." >&2
    echo "  It rewrites <image>-home volumes — including the one mounted as this container's \$HOME." >&2
    echo "  Run it from the host checkout." >&2
    return 1
  fi

  local __REPO="${${(%):-%x}:A:h}"
  local __IMAGES=("$@")

  if [[ "$1" == "--all" ]]; then
    # Don't guess names and then ask whether each one has a volume — ask which volumes exist.
    # Intersected with the dockerfile roster so a stray, unrelated <something>-home volume is
    # never handed codemonkey's dotfiles. Both sides are derived; neither is maintained by hand,
    # which is what let aichat and spark-bench fall out of the old hardcoded list.
    local __roster=(${(f)"$(_primate_roster)"})
    local __vol __name
    __IMAGES=()
    for __vol in ${(f)"$(docker volume ls --format '{{.Name}}' 2>/dev/null)"}; do
      [[ "$__vol" == *-home ]] || continue
      __name="${__vol%-home}"
      (( ${__roster[(I)$__name]} )) && __IMAGES+=("$__name")
    done
    if [[ ${#__IMAGES[@]} -eq 0 ]]; then
      echo "No primate home volumes found."
      return 0
    fi
  fi

  _primate_ensure_image codemonkey || return 1

  # The upgrade container's repo mount is resolved by the DAEMON HOST, so a container-local path
  # comes up empty when primate-upgrade is run from inside a primate. Translate it there.

  local __rc=0
  for __IMAGE in "${__IMAGES[@]}"; do
    local __VOL="${__IMAGE}-home"
    if ! docker volume inspect "$__VOL" &>/dev/null; then
      echo "skip: volume ${__VOL} does not exist"
      continue
    fi

    echo "upgrading ${__IMAGE}..."
    # The sync logic lives in primates/upgrade-home.sh — the same file `make <name>.upgrade`
    # runs, reached through the read-only repo mount. PRIMATE drives its per-image blocks.
    if docker run --rm \
      --env "PRIMATE=${__IMAGE}" \
      --volume "${__REPO}:/opt/user-jhunt:ro" \
      --volume "${__VOL}:/home/codemonkey" \
      codemonkey:latest bash /opt/user-jhunt/primates/upgrade-home.sh; then
      echo "  done: ${__IMAGE}"
    else
      echo "  FAILED: ${__IMAGE} (home volume may be partially upgraded)" >&2
      __rc=1
    fi
  done
  return $__rc
}

# starts (or re-attaches to) a long-lived, detached primate running an
# in-container tmux session that survives SSH disconnects. The container's
# PID 1 is `sleep infinity`, so dropping the ssh/exec link leaves the tmux
# server (and everything inside it) running. Re-run to re-attach.
#
#   primate-session <image> [session-name] [--no-workspace] [docker args...]
#   primate-session-list
#   primate-session-kill <session|container>
function primate-session() {

  local __NO_WORKSPACE=false
  local __ALLOW_HOME=false
  local __args=()
  for arg in "$@"; do
    if [[ "$arg" == "--no-workspace" ]]; then
      __NO_WORKSPACE=true
    elif [[ "$arg" == "--allow-home" ]]; then
      __ALLOW_HOME=true
    else
      __args+=("$arg")
    fi
  done
  set -- "${__args[@]}"

  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-session <image> [session-name] [--no-workspace] [--allow-home] [docker args...]"
    return 1
  fi

  local __IMAGE=$1
  shift

  _primate_ensure_image "$__IMAGE" || return 1

  # optional session/container name (defaults to <image>-session); only treated
  # as a name if it doesn't look like a docker flag
  local __NAME="${__IMAGE}-session"
  if [[ "$#" -ge 1 && "$1" != -* ]]; then
    __NAME="$1"
    shift
  fi

  local __TMUX_SESSION=main
  local __TERM="${TERM:-xterm-256color}"

  # already running? just re-attach.
  if [[ "$(docker inspect --format='{{.State.Running}}' "${__NAME}" 2>/dev/null)" == "true" ]]; then
    echo "re-attaching to ${__NAME} (tmux: ${__TMUX_SESSION})"
    docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
    return
  fi

  # exists but stopped? start it, then attach.
  if docker inspect "${__NAME}" &>/dev/null; then
    echo "starting stopped container ${__NAME}"
    docker start "${__NAME}" >/dev/null || return 1
    docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
    return
  fi

  # otherwise create it detached with the same mounts primate() uses.
  # The guard sits here, not up top: re-attaching to a session started elsewhere makes no new
  # mount, and refusing that from ~ would be a guard against nothing.
  if [[ "$__NO_WORKSPACE" == false && "$__ALLOW_HOME" == false ]]; then
    _primate_workspace_guard "$__IMAGE" primate-session || return 1
  fi

  _primate_first_run_sync "$__IMAGE"

  # HOST_* carry the host-side path of each shared dir into the container: bind mounts made
  # from inside a primate resolve on the daemon host, so `docker run -v` / compose volumes
  # need these paths, not the container's (see `hostpath` and CLAUDE.md Docker-out-of-Docker).
  local __WORKSPACE_MOUNT=()
  if [[ "$__NO_WORKSPACE" == false ]]; then
    local __HOST_WS="$(pwd)"
    __WORKSPACE_MOUNT=(--volume "${__HOST_WS}:/home/codemonkey/workspace" --env "HOST_WORKSPACE=${__HOST_WS}")
  fi

  local __ZFUNCS_DIR="${${(%):-%x}:A:h}"
  local __ENV_FILE="${__ZFUNCS_DIR}/env"
  local __ENV_FILE_MOUNT=()
  if [[ -f "$__ENV_FILE" ]]; then
    __ENV_FILE_MOUNT=(--env-file "$__ENV_FILE")
  fi

  local __GPU_OPTS=()
  if [[ "$(uname -r)" == *-nvidia ]]; then
    __GPU_OPTS=(--gpus all)
  fi

  local __PORT_OPTS=()
  local __PORTS=$(docker inspect --format='{{range $p, $_ := .Config.ExposedPorts}}{{$p}} {{end}}' "${__IMAGE}:latest" 2>/dev/null)
  for __PORT in ${=__PORTS}; do
    __PORT_OPTS+=(-p "${__PORT%/*}:${__PORT%/*}")
  done

  local __SSH_MOUNT=()
  if [[ -d ~/.ssh ]]; then
    local __HOST_SSH="$(cd -P ~/.ssh && pwd)"
    __SSH_MOUNT=(--volume "${__HOST_SSH}:/home/codemonkey/.ssh" --env "HOST_SSH_DIR=${__HOST_SSH}")
  fi

  local __AWS_MOUNT=()
  if [[ -d ~/.aws ]]; then
    local __HOST_AWS="$(cd -P ~/.aws && pwd)"
    __AWS_MOUNT=(--volume "${__HOST_AWS}:/home/codemonkey/.aws" --env "HOST_AWS_DIR=${__HOST_AWS}")
  fi

  local __DOCKER_MOUNT=()
  if [[ -S /var/run/docker.sock ]]; then
    __DOCKER_MOUNT=(--volume /var/run/docker.sock:/var/run/docker.sock --group-add "$(_primate_docker_gid)")
  fi

  echo "creating detached session ${__NAME} from ${__IMAGE} (home volume ${__IMAGE}-home)"
  # Label the container so `primate-session-list` and `primate-session-kill` can identify sessions
  # by asking docker, rather than by pattern-matching a "-session" suffix. A named session
  # (primate-session <image> <name>) is a container called <name> with nothing in the name to say
  # it is ours — the suffix convention simply cannot find it, and matching bare names is what let
  # an unrelated container get killed in its place. A label is a fact; a naming convention is a guess.
  docker run -d \
    --name "${__NAME}" \
    --label primate.managed \
    --label primate.session \
    --label "primate.image=${__IMAGE}" \
    --label "primate.name=${__NAME}" \
    --hostname "${__IMAGE}" \
    "${__ENV_FILE_MOUNT[@]}" \
    "${__GPU_OPTS[@]}" \
    "${__PORT_OPTS[@]}" \
    "${__SSH_MOUNT[@]}" \
    "${__AWS_MOUNT[@]}" \
    "${__DOCKER_MOUNT[@]}" \
    "${__WORKSPACE_MOUNT[@]}" \
    --volume ${__IMAGE}-home:/home/codemonkey \
    --user=codemonkey:codemonkey \
    $@ \
    ${__IMAGE} sleep infinity >/dev/null || return 1

  echo "attaching (tmux: ${__TMUX_SESSION}) — detach with ctrl-b d, kill with: primate-session-kill ${__NAME}"
  docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
}
compdef _primate primate-session

# Completes live session names for primate-session-kill, straight from the labels.
# The live session containers, by name, straight from the label. One query, four callers: the
# completer, the resolver, primate-session-resume's no-argument case, and primate-upgrade's
# sibling logic stays separate because it is about volumes, not containers.
function _primate_session_names() {
  docker ps -a --filter 'label=primate.session' --format '{{.Names}}' 2>/dev/null
}

# Resolve a session argument to a container name through the primate.session label, never a bare
# name match: only containers primate-session created are candidates, so an unrelated container
# that happens to share the name is untouchable. Shared by -kill and -resume so the two can never
# disagree about which container a name means — one resolving differently from the other is how
# you kill the session you meant to re-attach to.
function _primate_session_resolve() {
  local __arg="$1" __c
  local __labelled=(${(f)"$(_primate_session_names)"})
  for __c in "${__labelled[@]}"; do
    [[ "$__c" == "$__arg" || "$__c" == "${__arg}-session" ]] && { print -r -- "$__c"; return 0 }
  done
  # Pre-label sessions: suffix only. Never a bare exact match -- that is precisely the hole the
  # label filter closes, and reopening it in the fallback would defeat the point.
  if docker inspect "${__arg}-session" &>/dev/null; then
    print -r -- "${__arg}-session"
    return 0
  fi
  return 1
}

# This container's own id, empty on a host. cgroup is empty under cgroup v2 inside Docker
# Desktop's VM, so mountinfo is the source that actually answers: it carries the 64-hex id in the
# overlay paths. Used to keep primate-session-resume from attaching a session to itself.
function _primate_self_container_id() {
  [[ -f /.dockerenv ]] || return 0
  grep -oE '[0-9a-f]{64}' /proc/self/mountinfo 2>/dev/null | head -1
}

# Completes live session names for primate-session-kill and primate-session-resume.
function _primate_session() {
  local sessions=(${(f)"$(_primate_session_names)"})
  (( $#sessions )) || return 1
  _describe 'primate session' sessions
}
compdef _primate_session primate-session-kill
compdef _primate_session primate-session-resume

# re-attaches to a session by name alone, without having to remember which image it came from.
#
#   primate-session-resume [session]
#
# `primate-session <image> [name]` already re-attaches, but only if you can name the image; the
# session list is keyed on the session. With one session in flight the argument is redundant, so
# it is optional. A stopped container is started first — the home volume and the tmux server's
# state are both still there, which is the whole point of a session.
function primate-session-resume() {
  local __TMUX_SESSION=main
  local __TERM="${TERM:-xterm-256color}"
  local __NAME
  local __self="$(_primate_self_container_id)"

  if [[ "$#" -lt 1 ]]; then
    # Run from inside a session, the session you are in is not a candidate: it is the one thing
    # you cannot want to resume, and with it counted a lone other session stops being unambiguous.
    local __all=() __c
    for __c in ${(f)"$(_primate_session_names)"}; do
      [[ -n "$__self" && "$(docker inspect --format='{{.Id}}' "$__c" 2>/dev/null)" == "$__self" ]] && continue
      __all+=("$__c")
    done
    if (( $#__all == 1 )); then
      __NAME="${__all[1]}"
    elif (( $#__all == 0 )); then
      echo "No primate sessions to resume. Start one with: primate-session <image> [name]" >&2
      return 1
    else
      echo "primate-session-resume: more than one session is in flight — name one." >&2
      primate-session-list >&2
      return 1
    fi
  elif ! __NAME="$(_primate_session_resolve "$1")"; then
    echo "no primate session: $1" >&2
    echo "  (primate-session-list shows what is in flight; an unlabelled container of that name is not a session)" >&2
    return 1
  fi

  # Named explicitly, the same container still has to be refused — docker exec into your own
  # container nests this tmux inside itself, which looks like a hang rather than a mistake.
  if [[ -n "$__self" && "$(docker inspect --format='{{.Id}}' "$__NAME" 2>/dev/null)" == "$__self" ]]; then
    echo "primate-session-resume: ${__NAME} is the session you are already in." >&2
    echo "  Detach with ctrl-b d, or name a different one (primate-session-list)." >&2
    return 1
  fi

  if [[ "$(docker inspect --format='{{.State.Running}}' "$__NAME" 2>/dev/null)" != "true" ]]; then
    echo "starting stopped container ${__NAME}"
    docker start "$__NAME" >/dev/null || return 1
  fi

  echo "re-attaching to ${__NAME} (tmux: ${__TMUX_SESSION}) — detach with ctrl-b d"
  docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
}

# lists the primate sessions currently in flight, running or stopped.
#
# Sessions are found by their primate.session label, not by name: a named session's container is
# called whatever you named it. `docker ps -a --filter label=...` prints nothing both when there
# are no sessions and when it fails, so the query's exit status is checked separately — an empty
# list because the daemon is unreachable is not "no sessions", and reporting it as such is how a
# broken check passes for green.
function primate-session-list() {
  local __out __rc
  __out="$(docker ps -a --filter 'label=primate.session' \
    --format '{{.Label "primate.image"}}\t{{.Label "primate.name"}}\t{{.Names}}\t{{.Status}}' 2>&1)"
  __rc=$?
  if (( __rc != 0 )); then
    echo "ERROR: could not query docker for primate sessions (exit ${__rc})" >&2
    echo "${__out}" | sed 's/^/  /' >&2
    return 1
  fi
  if [[ -z "$__out" ]]; then
    echo "No primate sessions."
    return 0
  fi
  { print -r -- $'IMAGE\tSESSION\tCONTAINER\tSTATUS'; print -r -- "$__out"; } | column -t -s $'\t'
}

# stops and removes a primate session container (the <image>-home volume persists).
#
#   primate-session-kill <session|container>
#
# Resolution goes through the primate.session label, never a bare name match: only containers this
# function's counterpart created are candidates, so an unrelated container that happens to share the
# name is untouchable here. That is a property of the filter, not of the order things are tried --
# the previous name-ordering approach removed the wrong container and could only ever be tuned, not
# fixed. The <arg>-session fallback exists for sessions created before the labels did.
function primate-session-kill() {
  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-session-kill <session|container>   (see: primate-session-list)"
    return 1
  fi
  local __ARG="$1" __NAME=""
  if ! __NAME="$(_primate_session_resolve "$__ARG")"; then
    echo "no primate session: ${__ARG}" >&2
    echo "  (primate-session-list shows what is in flight; an unlabelled container of that name is not a session)" >&2
    return 1
  fi

  echo "removing ${__NAME} (home volume persists)"
  docker rm -f "${__NAME}" >/dev/null
}


# ── zoo ──────────────────────────────────────────────────────────────────────
#
# top(1) for primates. U1 is read-only: it lists every primate and session this
# daemon has, with live CPU and memory, and does nothing else. Keys that act on a
# container arrive with the units that implement them — an advertised key that
# does nothing is worse than an absent one.
#
# Two-tier refresh, because the two queries differ by 68x (measured on the live
# daemon, not assumed):
#   docker ps     ~0.03s  scales with container count; drives every tick
#   docker stats  ~2.05s  a fixed sampling window, independent of count
# So stats are sampled in a background job and the table renders from the last
# completed sample. A loop that refetched both together would freeze for two
# seconds per tick and swallow keystrokes.
#
# ZOO_PS_SESSION_SOURCE / ZOO_PS_MANAGED_SOURCE / ZOO_STATS_SOURCE replace the
# three docker queries with files so the collector can be fed fixtures and tested
# on a machine with no daemon. The two ps seams are separate because `kind` is
# decided by which query matched, and one merged fixture could not exercise that.
# Fixtures are their only purpose — zoo talks to one daemon and is not fleet-aware.

# Every primate, one row: kind, name, image, status, id, legacy — separated by
# 0x1F (unit separator), which cannot occur in a container name, image or status.
#
# `kind` comes from WHICH query matched, not from string-matching docker's
# comma-joined label blob. That blob was being tested with
# `[[ $labels == *primate.session=* ]]`, so a container merely NAMED
# "weird primate.session= name" classified as a session. The filter already knows
# the answer exactly; deriving it a second time by substring was inventing a way
# to be wrong about something already established.
#
# Two queries because docker ANDs repeated `--filter label=`, and sessions started
# before U0 carry primate.session but not primate.managed. Sessions are emitted
# first so a container matching both is a session; `legacy` is then just the set
# difference — in the session list, absent from the managed list.
#
# Failure and emptiness stay different answers: a non-zero docker exits non-zero
# here with its stderr intact.
function _zoo_ps() {
  local US=$'\x1f'
  local __sess __mgd
  if [[ -n "${ZOO_PS_SESSION_SOURCE:-}" || -n "${ZOO_PS_MANAGED_SOURCE:-}" ]]; then
    __sess="$(cat "${ZOO_PS_SESSION_SOURCE:-/dev/null}" 2>/dev/null)"
    __mgd="$(cat "${ZOO_PS_MANAGED_SOURCE:-/dev/null}" 2>/dev/null)"
  else
    local __fmt="{{.ID}}${US}{{.Names}}${US}{{.Image}}${US}{{.Status}}"
    __sess=$(docker ps -a --filter 'label=primate.session' --format "$__fmt" 2>&1) \
      || { print -r -- "$__sess" >&2; return 1 }
    __mgd=$(docker ps -a --filter 'label=primate.managed' --format "$__fmt" 2>&1) \
      || { print -r -- "$__mgd" >&2; return 1 }
  fi

  local -A __ismgd __seen
  local __l __id __rest
  for __l in ${(f)__mgd}; do
    [[ -n "$__l" ]] || continue
    __ismgd[${__l%%${US}*}]=1
  done
  for __l in ${(f)__sess}; do
    [[ -n "$__l" ]] || continue
    __id="${__l%%${US}*}"; __rest="${__l#*${US}}"
    __seen[$__id]=1
    if (( ${+__ismgd[$__id]} )); then
      print -r -- "session${US}${__rest}${US}${__id}${US}0"
    else
      print -r -- "session${US}${__rest}${US}${__id}${US}1"
    fi
  done
  for __l in ${(f)__mgd}; do
    [[ -n "$__l" ]] || continue
    __id="${__l%%${US}*}"
    (( ${+__seen[$__id]} )) && continue
    print -r -- "primate${US}${__l#*${US}}${US}${__id}${US}0"
  done
}

# id, cpu%, mem usage, mem%, pids — for running containers only.
function _zoo_stats() {
  if [[ -n "${ZOO_STATS_SOURCE:-}" ]]; then
    cat "$ZOO_STATS_SOURCE"
    return
  fi
  local US=$'\x1f'
  docker stats --no-stream \
    --format "{{.ID}}${US}{{.CPUPerc}}${US}{{.MemUsage}}${US}{{.MemPerc}}${US}{{.PIDs}}"
}

# Takes one row apart, once, into named fields. Every use site reads $ZOO_NAME and
# $ZOO_ID rather than indexing ${__g[2]} and ${__g[5]} after its own split.
#
# This is the shape jq would give for free by addressing fields by key. Without it
# there were five separate splits and only two checked their field count — so a
# wrong separator produced empty fields that surfaced three steps later as a
# self-guard refusal, which is exactly how the U2 bug presented and why it was
# looked for in the wrong place. A bad row now fails HERE, non-zero, at the split.
#
# Callers declare the ZOO_* names local, so nothing leaks into the shell:
#   local ZOO_KIND ZOO_NAME ZOO_IMAGE ZOO_STATUS ZOO_ID ZOO_LEGACY
#   _zoo_field "$row" || { ...it is not a row... }
function _zoo_field() {
  local __f=("${(@ps:\x1f:)1}")
  (( ${#__f} == 6 )) || return 1
  ZOO_KIND="${__f[1]}"; ZOO_NAME="${__f[2]}";   ZOO_IMAGE="${__f[3]}"
  ZOO_STATUS="${__f[4]}"; ZOO_ID="${__f[5]}"; ZOO_LEGACY="${__f[6]}"
}

# _zoo_ps already emits the final row shape; this is the one place that validates
# it, so the renderer and the action keys cannot disagree about what row N is.
# A short row is dropped rather than half-parsed — a row with missing fields is
# how an empty container id reached the kill.
function _zoo_rows() {
  local __line
  local ZOO_KIND ZOO_NAME ZOO_IMAGE ZOO_STATUS ZOO_ID ZOO_LEGACY
  for __line in ${(f)1}; do
    [[ -n "$__line" ]] || continue
    _zoo_field "$__line" || continue
    print -r -- "$__line"
  done
}

# Renders one frame to stdout. Split from the loop so it can be diffed against a
# fixture without a terminal.
#   $1 ps rows  $2 stats rows  $3 stats age (-1 = none yet)  $4 tick  $5 selected row (0 = none)
function _zoo_frame() {
  local __ps="$1" __st="$2" __age="$3" __tick="$4" __sel="${5:-0}"
  local -A __cpu __mem __memp __pids
  local __line __id __rest

  # Same separator as the ps rows. docker stats fields cannot contain 0x1F either,
  # and a short row is skipped rather than half-assigned.
  for __line in ${(f)__st}; do
    [[ -n "$__line" ]] || continue
    local __sf=("${(@ps:\x1f:)__line}")
    (( ${#__sf} == 5 )) || continue
    __id="${__sf[1]}"
    __cpu[$__id]="${__sf[2]}";  __mem[$__id]="${__sf[3]}"
    __memp[$__id]="${__sf[4]}"; __pids[$__id]="${__sf[5]}"
  done

  # Widths from the data, so a long session name does not shear the table.
  local -a __rows
  local ZOO_KIND ZOO_NAME ZOO_IMAGE ZOO_STATUS ZOO_ID ZOO_LEGACY
  local __np=0 __ns=0 __legacy=0
  local __wn=4 __wi=5 __ws=6
  for __line in ${(f)"$(_zoo_rows "$__ps")"}; do
    [[ -n "$__line" ]] || continue
    _zoo_field "$__line" || continue
    # if/else, not `a && { b } || c`: (( n++ )) evaluates to the OLD value, so the
    # first session made the ++ return 0, which is false, which ran the || branch
    # too and counted it as a primate as well.
    if [[ "$ZOO_KIND" == session ]]; then (( __ns++ )); else (( __np++ )); fi
    (( ZOO_LEGACY )) && __legacy=1
    (( ${#ZOO_NAME}   > __wn )) && __wn=${#ZOO_NAME}
    (( ${#ZOO_IMAGE}  > __wi )) && __wi=${#ZOO_IMAGE}
    (( ${#ZOO_STATUS} > __ws )) && __ws=${#ZOO_STATUS}
    __rows+=("$__line")
  done

  local __stale="" __agetxt="none yet"
  if (( __age >= 0 )); then
    __agetxt="${__age}s ago"
    (( __age > __tick * 3 )) && __stale=" (stale)"
  fi

  print -r -- "zoo — ${__np} primate$( (( __np == 1 )) || print -n s ), ${__ns} session$( (( __ns == 1 )) || print -n s ) · $(date +%H:%M:%S) · tick ${__tick}s · stats ${__agetxt}${__stale}"
  print -r -- ""
  printf "  %-7s  %-*s  %-*s  %-*s  %6s  %-17s  %6s  %5s\n" \
    KIND $__wn NAME $__wi IMAGE $__ws STATUS "CPU%" MEM "MEM%" PIDS

  if (( ${#__rows} == 0 )); then
    print -r -- ""
    print -r -- "  no primates — start one with: primate <image>   or   primate-session <image> [name]"
  fi

  local __r __n=0
  for __r in "${__rows[@]}"; do
    (( __n++ ))
    _zoo_field "$__r" || continue
    local __c="${__cpu[$ZOO_ID]:-—}" __m="${__mem[$ZOO_ID]:-—}"
    local __mp="${__memp[$ZOO_ID]:-—}" __p="${__pids[$ZOO_ID]:-—}"
    local __mark="  "
    (( __n == __sel )) && __mark="> "
    printf "%s%-7s  %-*s  %-*s  %-*s  %6s  %-17s  %6s  %5s\n" \
      "$__mark" "$ZOO_KIND" $__wn "$ZOO_NAME" $__wi "$ZOO_IMAGE" $__ws "$ZOO_STATUS" \
      "$__c" "$__m" "$__mp" "$__p"
  done

  print -r -- ""
  (( __legacy )) && print -r -- "note: a container above predates primate.managed; it is matched by primate.session until it is recycled."
  if (( ${#__rows} )); then
    print -r -- " ↑↓ select   a resume   e shell   k kill   n new session   N new primate   q quit   ? help"
  else
    print -r -- " n new session   N new primate   q quit   r refresh   ? help"
  fi
}

# The stats sample, written atomically by a background job: line 1 is the epoch
# second it completed, the rest is the sample. Carrying the timestamp inside the
# file avoids a stat(1) that spells its flags differently on Linux and macOS.
function _zoo_sample() {
  local __out="$1"
  # Every part of this is best-effort and detached, and zoo may already have exited
  # and deleted the directory underneath it — so nothing this job says belongs on
  # the user's terminal. It used to leave
  #   mv: rename /var/.../tmp.XXX.new to /var/.../tmp.XXX: No such file or directory
  # on the screen AFTER zoo had quit: alarming, unactionable, and about a temp file
  # nobody asked for. Silencing the whole block, not just the inner command, is what
  # matters — the failing redirect is as loud as the failing mv.
  {
    { print -r -- "$(date +%s)"; _zoo_stats } > "${__out}.new" \
      && mv -f "${__out}.new" "$__out"
  } 2>/dev/null
}

# Is $name still the container zoo selected? The row an action key acts on is as
# old as the prompt has been sitting there, which is unbounded — it blocks on a
# keypress. Kill and resume both address a session by NAME downstream, and session
# names are reusable, so the id has to be re-checked at the moment of action.
#
# Bounds the race rather than removing it: the downstream call resolves the name
# again itself. The window being closed is human thinking time.
function _zoo_same_container() {
  local __name="$1" __id="$2" __now
  __now="$(docker inspect --format '{{.Id}}' "$__name" 2>/dev/null)"
  if [[ -z "$__now" ]]; then
    print -r -- "refusing: ${__name} no longer exists."
    return 1
  fi
  if [[ "$__now" != "${__id}"* ]]; then
    print -r -- "refusing: ${__name} is a different container than the one selected."
    return 1
  fi
}

# The preflight every action key shares: a real row, not this container, and — for
# a session — still the container that was selected. Extracted before the second
# and third caller arrived rather than after, which is the lesson from the review:
# the kill path and the confirm prompt disagreeing about a row is what shipped a
# kill that killed nothing.
function _zoo_target_ok() {
  local __kind="$1" __name="$2" __id="$3"
  # An empty id makes the prefix test below match ANY self id — every string starts
  # with the empty string — so zoo would refuse every action and blame the
  # self-guard. An empty id here means the caller failed to parse a row.
  if [[ -z "$__id" || -z "$__name" ]]; then
    print -r -- "zoo: internal error — action called with no container (name='${__name}' id='${__id}')"
    return 2
  fi
  # docker ps gives a short id and _primate_self_container_id a full one, so this
  # is a prefix, not an equality; an equality would never match and the guard would
  # look present while doing nothing.
  local __self="$(_primate_self_container_id)"
  if [[ -n "$__self" && "$__self" == "${__id}"* ]]; then
    print -r -- "refusing: ${__name} is the container zoo is running in."
    return 1
  fi
  [[ "$__kind" == session ]] || return 0
  _zoo_same_container "$__name" "$__id"
}

# Kills one row. Sessions go through primate-session-kill so the label resolver
# stays the single answer to "which container is that name"; a foreground primate
# is --rm, so removing it IS the kill.
#
# Refuses the container zoo is itself running in. docker ps gives a short id and
# _primate_self_container_id a full one, so the comparison is a prefix, not an
# equality — comparing them directly would silently never match and the guard
# would look present while doing nothing.
function _zoo_kill() {
  local __kind="$1" __name="$2" __id="$3"
  _zoo_target_ok "$__kind" "$__name" "$__id" || return $?
  if [[ "$__kind" == session ]]; then
    primate-session-kill "$__name"
  else
    print -r -- "removing ${__name} (foreground primate; --rm, so this is the kill)"
    docker rm -f "$__id" >/dev/null || return 1
  fi
}

# Re-attaches to a session's tmux, through primate-session-resume so the label
# resolver stays the single answer to which container a name means.
#
# Sessions only. A foreground primate has no tmux server to re-attach to — its
# shell is bound to the terminal that started it, which is not this one. Saying so
# is better than offering `e` silently instead: they are different things and the
# difference is the point of having two keys.
function _zoo_attach() {
  local __kind="$1" __name="$2" __id="$3"
  if [[ "$__kind" != session ]]; then
    print -r -- "refusing: ${__name} is a foreground primate — it has no tmux to re-attach to."
    print -r -- "  its shell belongs to the terminal that started it. 'e' opens a NEW shell in it."
    return 1
  fi
  _zoo_target_ok "$__kind" "$__name" "$__id" || return $?
  primate-session-resume "$__name"
}

# Opens a NEW shell in the container. Deliberately not called "attach": it is not
# the original terminal, and describing it as attaching would be a lie a user only
# discovers after wondering why their scrollback is gone.
function _zoo_exec() {
  local __kind="$1" __name="$2" __id="$3" __status="$4"
  _zoo_target_ok "$__kind" "$__name" "$__id" || return $?
  if [[ "$__status" != Up* ]]; then
    print -r -- "refusing: ${__name} is not running (${__status}) — there is nothing to exec into."
    [[ "$__kind" == session ]] && print -r -- "  'a' starts a stopped session and re-attaches it."
    return 1
  fi
  docker exec -it "$__id" zsh
}

# Picks an image from the roster, into ZOO_PICK. Non-zero means cancelled.
# Caller declares ZOO_PICK local, as with _zoo_field.
#
# Same ↑↓ idiom as the table rather than a numbered menu: the roster is 17 images
# and single-key numbers stop working at 9. Assumes the alternate screen is already
# up — it is only ever called from inside the loop.
function _zoo_pick_image() {
  local -a __imgs=(${(f)"$(_primate_roster)"})
  if (( ${#__imgs} == 0 )); then
    tput cup 0 0 2>/dev/null
    print -r -- "zoo — no roster here"
    print -r -- ""
    print -r -- "  The image list comes from primates/*.dockerfile next to zfuncs. Inside a"
    print -r -- "  primate ~/.zfuncs is a standalone copy with no sibling primates/, so there"
    print -r -- "  is nothing to offer. Launch from the host checkout."
    print -r -- ""
    print -r -- " any key to return"
    tput ed 2>/dev/null; read -k 1 2>/dev/null
    return 1
  fi
  local __i=1 __key __seq __n __im
  while true; do
    tput cup 0 0 2>/dev/null
    print -r -- "zoo — $1"
    print -r -- ""
    # The workspace is whatever zoo was started in, because that is what the
    # launchers mount. Worth showing before starting something, not after.
    print -r -- "  workspace to mount: $(pwd)"
    print -r -- ""
    __n=0
    for __im in "${__imgs[@]}"; do
      (( __n++ ))
      if (( __n == __i )); then print -r -- "  > ${__im}"; else print -r -- "    ${__im}"; fi
    done
    print -r -- ""
    print -r -- " ↑↓ choose   enter start   esc / q cancel"
    tput ed 2>/dev/null
    read -k 1 __key 2>/dev/null || return 1
    case "$__key" in
      $'\n'|$'\r') ZOO_PICK="${__imgs[$__i]}"; return 0 ;;
      q) return 1 ;;
      $'\e')
        __seq=""
        read -k 2 -t 1 __seq 2>/dev/null
        case "$__seq" in
          '[A') (( __i > 1 )) && (( __i-- )) ;;
          '[B') (( __i < ${#__imgs} )) && (( __i++ )) ;;
          '')   return 1 ;;   # a bare ESC, not an arrow: cancel
        esac ;;
    esac
  done
}

function _zoo_teardown() {
  tput cnorm 2>/dev/null
  tput rmcup 2>/dev/null
}

function _zoo_help() {
  print -r -- "zoo — top(1) for primates"
  print -r -- ""
  print -r -- "  usage: zoo [-i|--interval <seconds>] [--once] [-h|--help]"
  print -r -- ""
  print -r -- "  ↑ ↓  select a row    a  re-attach to a session (tmux)"
  print -r -- "  k    kill (asks)     e  open a NEW shell in the container"
  print -r -- "  n    new session     N  new foreground primate"
  print -r -- "  q    quit            r  refresh now         ?  this help"
  print -r -- ""
  print -r -- "  j/k are not bound to navigation: k is kill, and overloading it is"
  print -r -- "  how a navigation keystroke becomes a destructive one."
  print -r -- ""
  print -r -- "  KIND is 'session' for a detached primate-session container and"
  print -r -- "  'primate' for a foreground primate. Stopped sessions are listed"
  print -r -- "  too — they still hold a home volume and are still resumable."
  print -r -- ""
  print -r -- "  MEM's total is the docker daemon's memory limit, which on macOS is"
  print -r -- "  the Docker Desktop VM's, not the host's."
  print -r -- ""
  print -r -- "  Stats come from 'docker stats', a ~2s sampling window, so they are"
  print -r -- "  collected in the background and may lag the table by a tick. A"
  print -r -- "  sample older than three ticks is marked stale rather than shown as"
  print -r -- "  current."
  print -r -- ""
  print -r -- "  Killing a session leaves its <image>-home volume alone. zoo refuses to"
  print -r -- "  act on the container it is itself running in."
  print -r -- ""
  print -r -- "  'a' works on sessions only: a foreground primate has no tmux server to"
  print -r -- "  re-attach to, since its shell belongs to the terminal that started it."
  print -r -- "  'e' opens a NEW shell in any running container — it is not the original"
  print -r -- "  terminal, which is why it is not called attach."
  print -r -- ""
  print -r -- "  n and N pick an image and hand over to primate-session / primate, which"
  print -r -- "  own the workspace mount, the \$HOME refusal and the first-run config sync."
  print -r -- "  The workspace mounted is whatever directory zoo was started in, shown on"
  print -r -- "  the picker before you commit to it. Both return here when they end."
}

function zoo() {
  local __tick=3 __once=false
  while (( $# )); do
    case "$1" in
      -i|--interval)
        # Check before shifting: setting __tick empty and then letting `shift 2`
        # fail produced a raw "shift count must be <= $#" instead of this message.
        if (( $# < 2 )); then
          print -r -- "zoo: --interval wants a positive whole number of seconds" >&2
          return 1
        fi
        __tick="$2"; shift 2 ;;
      --once)        __once=true; shift ;;
      -h|--help)     _zoo_help; return 0 ;;
      *) print -r -- "zoo: unknown option: $1" >&2; _zoo_help >&2; return 1 ;;
    esac
  done
  if [[ ! "$__tick" == <-> ]] || (( __tick < 1 )); then
    print -r -- "zoo: --interval wants a positive whole number of seconds" >&2
    return 1
  fi

  # A directory, not two files. The teardown removes it whole while the sampler may
  # still be running; a write into a directory that no longer exists creates nothing,
  # whereas a sample completing just after two files were deleted left an orphan in
  # /tmp on every such race.
  local __sd="$(mktemp -d)" __spid=0 __rc=0 __sel=1
  local __sf="${__sd}/stats"
  # Not a terminal, or asked for one frame: print it and leave. Keeps zoo usable
  # in a pipe and testable without a pty.
  if [[ "$__once" == true || ! -t 1 ]]; then
    local __ps
    if ! __ps=$(_zoo_ps); then
      print -r -- "zoo: could not query docker for primates" >&2
      rm -rf "$__sd"
      return 1
    fi
    _zoo_frame "$__ps" "$(_zoo_stats 2>/dev/null)" 0 "$__tick"
    rm -rf "$__sd"
    return 0
  fi

  tput smcup 2>/dev/null; tput civis 2>/dev/null
  # The `always` block below does NOT run when the shell takes SIGINT: verified by
  # sending ctrl-c through a pty and finding smcup 1 / rmcup 0 and civis 1 /
  # cnorm 0 in the captured output — the terminal was left in the alternate screen
  # with the cursor hidden. `always` covers every other exit and the temp file;
  # this covers the one a user actually types.
  trap '_zoo_teardown; return 130' INT TERM
  {
    while true; do
      local __ps
      if ! __ps=$(_zoo_ps 2>&1); then
        tput cup 0 0 2>/dev/null
        print -r -- "zoo: could not query docker for primates — this is not the same as none running:"
        print -r -- "$__ps" | sed 's/^/  /'
        print -r -- ""
        print -r -- " q quit   r retry"
        tput ed 2>/dev/null
        read -t "$__tick" -k 1 __key 2>/dev/null
        [[ "$__key" == q ]] && { __rc=1; break }
        continue
      fi

      if (( __spid == 0 )) || ! kill -0 "$__spid" 2>/dev/null; then
        _zoo_sample "$__sf" &!
        __spid=$!
      fi

      local __age=-1 __st=""
      if [[ -s "$__sf" ]]; then
        local __all="$(<"$__sf")"
        __st="${__all#*$'\n'}"
        __age=$(( $(date +%s) - ${__all%%$'\n'*} ))
      fi

      # Same parse the frame uses, so "row 3" means the same thing to the cursor
      # and to the kill. Clamped every tick because the list shrinks under us.
      local -a __rowarr=(${(f)"$(_zoo_rows "$__ps")"})
      local __nrows=${#__rowarr}
      (( __sel > __nrows )) && __sel=$__nrows
      (( __nrows > 0 && __sel < 1 )) && __sel=1

      tput cup 0 0 2>/dev/null
      _zoo_frame "$__ps" "$__st" "$__age" "$__tick" "$__sel"
      tput ed 2>/dev/null

      local __key=""
      read -t "$__tick" -k 1 __key 2>/dev/null

      # Arrows arrive as ESC [ A / ESC [ B. j/k are deliberately not bound: k is
      # kill, and quietly overloading it is how a navigation keystroke becomes a
      # destructive one.
      if [[ "$__key" == $'\e' ]]; then
        local __seq=""
        read -k 2 -t 1 __seq 2>/dev/null
        case "$__seq" in
          '[A') (( __sel > 1 )) && (( __sel-- )) ;;
          '[B') (( __sel < __nrows )) && (( __sel++ )) ;;
        esac
        continue
      fi

      case "$__key" in
        q) break ;;
        k) (( __nrows == 0 )) && continue
           local ZOO_KIND ZOO_NAME ZOO_IMAGE ZOO_STATUS ZOO_ID ZOO_LEGACY
           if ! _zoo_field "${__rowarr[$__sel]}"; then
             tput cup 0 0 2>/dev/null
             print -r -- "zoo: internal error — row ${__sel} is not a row; refusing to act on it."
             print -r -- ""; print -r -- " any key to continue"
             tput ed 2>/dev/null; read -k 1 2>/dev/null
             continue
           fi
           tput cup 0 0 2>/dev/null
           print -r -- "zoo — confirm"
           print -r -- ""
           print -r -- "  kill ${ZOO_KIND} ${ZOO_NAME}   (${ZOO_IMAGE}, ${ZOO_STATUS})"
           if [[ "$ZOO_KIND" == session ]]; then
             print -r -- "  the ${ZOO_IMAGE}-home volume persists; the session can be started again."
           else
             print -r -- "  a foreground primate is --rm, so removing it is the kill."
           fi
           print -r -- ""
           print -r -- "  y  confirm       any other key cancels"
           tput ed 2>/dev/null
           local __c=""; read -k 1 __c 2>/dev/null
           if [[ "$__c" == y ]]; then
             tput cup 0 0 2>/dev/null; print -r -- "zoo"; print -r -- ""
             _zoo_kill "$ZOO_KIND" "$ZOO_NAME" "$ZOO_ID" 2>&1 | sed 's/^/  /'
             print -r -- ""
             print -r -- " any key to continue"
             tput ed 2>/dev/null; read -k 1 2>/dev/null
           fi ;;
        n|N) local ZOO_PICK=""
           local __what="new session — detached, survives a disconnect, returns here"
           [[ "$__key" == N ]] && __what="new foreground primate — owns this terminal until it exits"
           if _zoo_pick_image "$__what"; then
             # Hand over exactly as a/e do. Both launchers own the workspace mount,
             # the $HOME guard and the first-run sync; zoo picks a name and gets out
             # of the way rather than reimplementing any of it.
             _zoo_teardown
             if [[ "$__key" == n ]]; then
               primate-session "$ZOO_PICK"
             else
               primate "$ZOO_PICK"
             fi || { print -r -- ""; print -r -- "  any key to return to zoo"; read -k 1 2>/dev/null }
             tput smcup 2>/dev/null; tput civis 2>/dev/null
           fi ;;
        a|e) (( __nrows == 0 )) && continue
           local ZOO_KIND ZOO_NAME ZOO_IMAGE ZOO_STATUS ZOO_ID ZOO_LEGACY
           if ! _zoo_field "${__rowarr[$__sel]}"; then
             tput cup 0 0 2>/dev/null
             print -r -- "zoo: internal error — row ${__sel} is not a row; refusing to act on it."
             print -r -- ""; print -r -- " any key to continue"
             tput ed 2>/dev/null; read -k 1 2>/dev/null
             continue
           fi
           # Leave the alternate screen BEFORE acting. A successful handoff needs the
           # real terminal — tmux and an interactive shell both want it — and a refusal
           # then prints where the user can scroll back to it. One path for both.
           _zoo_teardown
           if [[ "$__key" == a ]]; then
             _zoo_attach "$ZOO_KIND" "$ZOO_NAME" "$ZOO_ID"
           else
             _zoo_exec "$ZOO_KIND" "$ZOO_NAME" "$ZOO_ID" "$ZOO_STATUS"
           fi || { print -r -- ""; print -r -- "  any key to return to zoo"; read -k 1 2>/dev/null }
           tput smcup 2>/dev/null; tput civis 2>/dev/null ;;
        '?') tput cup 0 0 2>/dev/null; _zoo_help; print -r -- ""
             print -r -- " any key to return"; tput ed 2>/dev/null
             read -k 1 2>/dev/null ;;
        *) ;;   # r, and every other key, just falls through to a redraw
      esac
    done
  } always {
    _zoo_teardown
    trap - INT TERM
    # The sampler is still not killed — its pid may already be reaped and reused, and
    # signalling that would hit an unrelated process. Removing the directory out from
    # under it is safe now that it is silent: a write into a directory that is gone
    # creates nothing and says nothing.
    rm -rf "$__sd"
  }
  return $__rc
}
compdef '_values "options" "--interval[seconds between refreshes]" "--once[print one frame and exit]" "--help[usage]"' zoo

# Take A Dump (takes a java heapdump in a running container)
function tad() {

  if [[ "$#" -ne 1 ]]; then
    echo "Usage: take-a-dump <target container name>"
    return 1
  fi
  local _TARGET=$1

  echo "Taking a dump of ${_TARGET}"

  _PID=$(docker exec ${_TARGET} ps aux | grep java | awk '{print $2}')
  if [[ -z ${_PID} ]]; then
	  echo "unable to to find Java process"
	  return 1
  fi
  echo "Found Java PID: ${_PID}"

  _JDK=$(docker exec ${_TARGET} ps aux | grep java | awk '{print $11}' | sed 's/\(.*\)\/java/\1/g' )
  if [[ -z ${_JDK} ]]; then
	  echo "unable to find jmap"
	  return 1
  fi
  echo "Found Java PID: ${_JDK}"

  _DATE=$(date +"%s")
  _FILENAME="${_TARGET}--heap-${_DATE}.hprof"
  echo "Taking a heap dump of ${TARGET} with PID:${_PID} using ${_JDK}/jmap -dump:format=b,file=/dumps/${TARGET}-heap-${_DATE}.hprof ${_PID}"
  docker exec ${_TARGET} $_JDK/jmap -dump:format=b,file=/dumps/${_TARGET}-heap-01.hprof $_PID

  echo "dump taken ${_FILENAME}, check in host /tmp directory"
}

function which-os() {
  local os=$(uname -a | awk '{print $1}')
  if [[ "${os}" = "Darwin" ]]; then
    echo -n "MacOS"
  elif [[ "${os}" = "Linux" ]]; then
    echo -n "Linux"
  elif [[ "${os}" = "Win32" ]]; then
    echo -n "WSL"
  else 
    return "Unknown"
  fi
}

function code-mac() {
  open -a XQuartz
  xhost +localhost

  if [[ $# = 0 ]]
  then
    open -a "Visual Studio Code"
  else
    [[ $1 = /* ]] && F="$1" || F="$PWD/${1#./}"
    open -a "Visual Studio Code" --args "$F"
  fi
}

function code-linux() {
  if [[ $# = 0 ]]
  then
    code .
  else
    code $@
  fi 
}

function code-win() {
  # TODO
}

function code-here () {
  local os=$(which-os)
  if [[ "${os}" = "Linux" ]]; then
    code-linux $@
    return
  elif [[ "${os}" = "MacOS" ]]; then
    code-mac $@
    return
  fi
}

function tree () {
  local os=$(which-os)
  if [[ "${os}" != "MacOS" ]]; then
    /usr/bin/tree $@
    return
  fi
  if [[ -n $* ]]; then
    if [[ $1 == /* ]]; then
      _TARGET=$1
    else
      _TARGET=$(pwd)/$1
    fi
    docker run --rm -e _TARGET=${_TARGET} -v ${_TARGET}:/tmp minion bash -c 'echo ${_TARGET}; cd /tmp; tree | tail -n +2 '
  else
    local _TARGET=$(pwd)
    docker run --rm -e _TARGET=${_TARGET} -v $(pwd):/tmp minion bash -c 'echo ${_TARGET}; cd /tmp; tree | tail -n +2 '
  fi
}

function TAR () {
  if [[ "$#" -ne 3 ]]; then
    echo "Usage: TAR <args> <target> <source>"
    return 1
  fi

  local _ARGS=$1
  local _TARGET=$2
  local _SOURCE=$3
  local _DEST=$(pwd)

  docker run --rm \
    -e _ARGS=${_ARGS} \
    -e _TARGET=${_TARGET} \
    -e _SOURCE=${_SOURCE} \
    -v ${_DEST}:/tmp/.TAR.ouput \
    -v ${_DEST}/${_SOURCE}:/tmp/${_SOURCE} \
    minion bash -c 'cd /tmp; tar ${_ARGS} ${_TARGET} ${_SOURCE}; mv ${_TARGET} /tmp/.TAR.ouput;'
}

function clamscan() {
  local _TARGET=
  if [[ -n $* ]]; then
    _TARGET=$1
  else
    _TARGET=$(pwd)
  fi
  docker run --rm -v ${_TARGET}:/scan minion bash -c 'clamscan -r /scan' | sed 's/\/scan\///'
}

function pmd () {
  #pmd check -d /usr/src -R rulesets/java/quickstart.xml -f text
  local _TARGET=
  if [[ -n $* ]]; then
    _TARGET=$[$#]
  else
    _TARGET=$(pwd)
  fi
    docker run --rm -e _TARGET=${_TARGET} -v $(pwd):/tmp/src minion bash -c 'echo ${_TARGET}; cd /tmp; pmd check -d /tmp/src rulesets/java/quickstart.xml -f text'
}

function watch() {
  if [[ "$#" -ne 1 ]]; then
    echo "Usage: watch <command>"
    return 1
  fi
  local _TARGET=$1
  local _STARTED=$(date)

  while (true); do
    clear
    local _LAST=$(date)

    echo "watching ${_TARGET}"
    echo "started on ${_STARTED}, last run on ${_LAST}, rerun in 2 seconds"

    echo
    zsh -c "${_TARGET}"
    sleep 2
  done
}

