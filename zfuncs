# load env file into current shell as exported variables
function setenv() {
  local __ENV_FILE="${1:-${${(%):-%x}:A:h}/env}"
  if [[ ! -f "$__ENV_FILE" ]]; then
    echo "env file not found: ${__ENV_FILE}"
    return 1
  fi
  set -a
  source "$__ENV_FILE"
  set +a
  echo "loaded: ${__ENV_FILE}"
}

# Ensure <image>:latest exists locally; if not, pull it from the fleet ECR and retag to the bare
# local name the primate functions expect. Lets `primate <name>` work on a host that has never
# built the image. Creds come from the host ~/.aws (containerized aws-cli — no host install).
function _primate_ensure_image() {
  local __img=$1
  docker image inspect "${__img}:latest" >/dev/null 2>&1 && return 0
  local __ecr="${CODEMONKEYS_ECR:-521147433280.dkr.ecr.us-east-1.amazonaws.com}"
  local __ref="${__ecr}/codemonkeys/${__img}:latest"
  echo "  ${__img}:latest not present locally — pulling ${__ref}"
  docker run --rm -v "$HOME/.aws:/root/.aws:ro" \
    -e AWS_PROFILE -e AWS_REGION -e AWS_DEFAULT_REGION \
    amazon/aws-cli \
    ecr get-login-password --region "${AWS_REGION:-us-east-1}" 2>/dev/null \
    | docker login --username AWS --password-stdin "$__ecr" >/dev/null 2>&1
  if docker pull "$__ref"; then
    docker tag "$__ref" "${__img}:latest"
  else
    echo "  ERROR: ${__img} is not local and could not be pulled from ECR (${__ref})" >&2
    return 1
  fi
}

# Resolve the fleet inventory. On the host, ~/.zfuncs is a symlink into the repo checkout, so the
# repo-relative path wins. Inside a primate, ~/.zfuncs is a COPY (upgrade-home.sh / the image bake),
# so that path does not exist and we fall back to ~/.fleet.conf — which is itself a copy of the same
# primates/fleet.conf, installed by codemonkey.dockerfile and refreshed by upgrade-home.sh. Both are
# derived from the one source of truth; neither is a hand-maintained list. Prints the resolved path.
function _primate_fleet_conf() {
  local __repo_fleet="${${(%):-%x}:A:h}/primates/fleet.conf"
  local __home_fleet="${HOME}/.fleet.conf"
  local __f
  for __f in "$__repo_fleet" "$__home_fleet"; do
    if [[ -r "$__f" && -s "$__f" ]]; then
      print -r -- "$__f"
      return 0
    fi
  done
  return 1
}

# gid to --group-add alongside the /var/run/docker.sock mount so the unprivileged codemonkey
# user can open the socket without anyone touching its perms (mirrors bin/spark-bench).
# Linux: the socket's real group (the host's `docker` group, or 0 inside a Docker Desktop VM).
# macOS: the host-side stat is meaningless — Docker Desktop's VM presents the socket to
# containers as root:root 660 — so the answer is always 0. --group-add 0 grants only the root
# *group* (the socket's rw group bit), not root privileges.
function _primate_docker_gid() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo 0
  else
    stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0
  fi
}

# starts a primate container with a persistent home volume
function primate() {

  local __NO_WORKSPACE=false
  local __args=()
  for arg in "$@"; do
    if [[ "$arg" == "--no-workspace" ]]; then
      __NO_WORKSPACE=true
    else
      __args+=("$arg")
    fi
  done
  set -- "${__args[@]}"

  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate <image> [--no-workspace] [docker args...]"
    return 1
  fi

  local __IMAGE=$1
  shift

  _primate_ensure_image "$__IMAGE" || return 1

  # HOST_* carry the host-side path of each shared dir into the container: bind mounts made
  # from inside a primate resolve on the daemon host, so `docker run -v` / compose volumes
  # need these paths, not the container's (see `hostpath` and CLAUDE.md Docker-out-of-Docker).
  local __WORKSPACE_MOUNT=()
  if [[ "$__NO_WORKSPACE" == false ]]; then
    local __HOST_WS="$(pwd)"
    __WORKSPACE_MOUNT=(--volume "${__HOST_WS}:/home/codemonkey/workspace" --env "HOST_WORKSPACE=${__HOST_WS}")
  fi

  local __ZFUNCS_DIR="${${(%):-%x}:A:h}"
  local __ENV_FILE="${__ZFUNCS_DIR}/env"
  local __ENV_FILE_MOUNT=()
  if [[ -f "$__ENV_FILE" ]]; then
    __ENV_FILE_MOUNT=(--env-file "$__ENV_FILE")
  fi

  echo "starting ${__IMAGE} with volume ${__IMAGE}-home"

  local __CMD=(zsh)
  local __ENTRYPOINT=$(docker inspect --format='{{len .Config.Entrypoint}}' "${__IMAGE}:latest" 2>/dev/null)
  if [[ "$__ENTRYPOINT" -gt 0 ]]; then
    __CMD=()
  fi

  local __GPU_OPTS=()
  if [[ "$(uname -r)" == *-nvidia ]]; then
    __GPU_OPTS=(--gpus all)
  fi

  local __PORT_OPTS=()
  local __PORTS=$(docker inspect --format='{{range $p, $_ := .Config.ExposedPorts}}{{$p}} {{end}}' "${__IMAGE}:latest" 2>/dev/null)
  for __PORT in ${=__PORTS}; do
    __PORT_OPTS+=(-p "${__PORT%/*}:${__PORT%/*}")
  done

  local __SSH_MOUNT=()
  if [[ -d ~/.ssh ]]; then
    local __HOST_SSH="$(cd -P ~/.ssh && pwd)"
    __SSH_MOUNT=(--volume "${__HOST_SSH}:/home/codemonkey/.ssh" --env "HOST_SSH_DIR=${__HOST_SSH}")
  fi

  local __AWS_MOUNT=()
  if [[ -d ~/.aws ]]; then
    local __HOST_AWS="$(cd -P ~/.aws && pwd)"
    __AWS_MOUNT=(--volume "${__HOST_AWS}:/home/codemonkey/.aws" --env "HOST_AWS_DIR=${__HOST_AWS}")
  fi

  local __DOCKER_MOUNT=()
  if [[ -S /var/run/docker.sock ]]; then
    __DOCKER_MOUNT=(--volume /var/run/docker.sock:/var/run/docker.sock --group-add "$(_primate_docker_gid)")
  fi

  docker run --rm -it \
    --hostname "${__IMAGE}" \
    "${__ENV_FILE_MOUNT[@]}" \
    "${__GPU_OPTS[@]}" \
    "${__PORT_OPTS[@]}" \
    "${__SSH_MOUNT[@]}" \
    "${__AWS_MOUNT[@]}" \
    "${__DOCKER_MOUNT[@]}" \
    "${__WORKSPACE_MOUNT[@]}" \
    --volume ${__IMAGE}-home:/home/codemonkey \
    --user=codemonkey:codemonkey \
    $@ \
    ${__IMAGE} "${__CMD[@]}"
}

function _primate() {
  # All fleet primates — any not present locally is pulled from ECR on demand by _primate_ensure_image,
  # so offer the full set (names match the ECR repos under codemonkeys/*), not just locally-built images.
  # No membership predicate: every well-formed row is a valid completion target, whether or not a bare
  # build-push/manifest-push run sweeps it up. NF==7 is a SHAPE check, not a membership one — without it
  # a malformed inventory would be offered verbatim as primate names instead of erroring like the other
  # consumers do. Read inside the function, never at source time.
  local __FLEET
  if ! __FLEET="$(_primate_fleet_conf)"; then
    _message "ERROR: no readable fleet inventory (primates/fleet.conf or ~/.fleet.conf) — primate name completion unavailable"
    return 1
  fi
  # `< "$__FLEET"` and not `awk ... "$__FLEET"`: mawk (Debian's awk, so every primate's) treats an
  # EMPTY filename argument as stdin, which at completion time is the terminal — the shell hangs
  # instead of reaching the guard below. A redirection of "" fails immediately instead. Belt and
  # braces on top of the return check above, because the cost of getting this wrong is a wedged tab.
  local known_primates=(${(f)"$(awk -F: '/^#/{next} {gsub(/[ \t\r]+/,"")} NF==7 {print $1}' < "$__FLEET" 2>/dev/null)"})
  if [[ ${#known_primates[@]} -eq 0 ]]; then
    _message "ERROR: ${__FLEET} is not a well-formed fleet inventory — primate name completion unavailable"
    return 1
  fi

  case "$CURRENT" in
    2) _describe 'primate image' known_primates ;;
    *) _values 'options' '--no-workspace[Do not mount the current directory as workspace]' ;;
  esac
}
compdef _primate primate

function primate-upgrade() {
  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-upgrade <image> [image...]"
    echo "       primate-upgrade --all"
    return 1
  fi

  local __REPO="${${(%):-%x}:A:h}"
  local __IMAGES=("$@")

  if [[ "$1" == "--all" ]]; then
    # home_volume=yes rows from primates/fleet.conf — codemonkey included, exactly as the
    # Makefile's UPGRADE_TARGETS reads it. _primate_ensure_image below only PULLS that image;
    # it does not upgrade codemonkey-home, so excluding it here would skip that volume.
    local __FLEET
    if ! __FLEET="$(_primate_fleet_conf)"; then
      echo "ERROR: no readable fleet inventory (tried the repo's primates/fleet.conf and ${HOME}/.fleet.conf) — refusing to silently upgrade zero primates" >&2
      return 1
    fi
    local known=(${(f)"$(awk -F: '/^#/{next} {gsub(/[ \t\r]+/,"")} NF==7 && $7=="yes" {print $1}' < "$__FLEET")"})
    if [[ ${#known[@]} -eq 0 ]]; then
      echo "ERROR: ${__FLEET} parsed to zero home_volume=yes primates — check its format" >&2
      return 1
    fi
    __IMAGES=()
    for name in "${known[@]}"; do
      if docker volume inspect "${name}-home" &>/dev/null; then
        __IMAGES+=("$name")
      fi
    done
    if [[ ${#__IMAGES[@]} -eq 0 ]]; then
      echo "No primate home volumes found."
      return 0
    fi
  fi

  _primate_ensure_image codemonkey || return 1

  # The upgrade container's repo mount is resolved by the DAEMON HOST, so a container-local path
  # comes up empty when primate-upgrade is run from inside a primate. Translate it there.
  local __SRC="${__REPO}"
  if [[ -f /.dockerenv ]] && (( $+commands[hostpath] )); then
    if ! __SRC="$(hostpath "${__REPO}")"; then
      echo "ERROR: ${__REPO} is not under a host-shared mount, so the upgrade container cannot see it." >&2
      echo "       Bind mounts resolve on the Docker daemon host — run this from the host checkout." >&2
      return 1
    fi
  fi

  local __rc=0
  for __IMAGE in "${__IMAGES[@]}"; do
    local __VOL="${__IMAGE}-home"
    if ! docker volume inspect "$__VOL" &>/dev/null; then
      echo "skip: volume ${__VOL} does not exist"
      continue
    fi

    echo "upgrading ${__IMAGE}..."
    # The sync logic lives in primates/upgrade-home.sh — the same file `make <name>.upgrade`
    # runs, reached through the read-only repo mount. PRIMATE drives its per-image blocks.
    if docker run --rm \
      --env "PRIMATE=${__IMAGE}" \
      --volume "${__SRC}:/opt/user-jhunt:ro" \
      --volume "${__VOL}:/home/codemonkey" \
      codemonkey:latest bash /opt/user-jhunt/primates/upgrade-home.sh; then
      echo "  done: ${__IMAGE}"
    else
      echo "  FAILED: ${__IMAGE} (home volume may be partially upgraded)" >&2
      __rc=1
    fi
  done
  return $__rc
}

# starts (or re-attaches to) a long-lived, detached primate running an
# in-container tmux session that survives SSH disconnects. The container's
# PID 1 is `sleep infinity`, so dropping the ssh/exec link leaves the tmux
# server (and everything inside it) running. Re-run to re-attach.
#
#   primate-session <image> [session-name] [--no-workspace] [docker args...]
#   primate-kill    <image|container-name>
function primate-session() {

  local __NO_WORKSPACE=false
  local __args=()
  for arg in "$@"; do
    if [[ "$arg" == "--no-workspace" ]]; then
      __NO_WORKSPACE=true
    else
      __args+=("$arg")
    fi
  done
  set -- "${__args[@]}"

  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-session <image> [session-name] [--no-workspace] [docker args...]"
    return 1
  fi

  local __IMAGE=$1
  shift

  _primate_ensure_image "$__IMAGE" || return 1

  # optional session/container name (defaults to <image>-session); only treated
  # as a name if it doesn't look like a docker flag
  local __NAME="${__IMAGE}-session"
  if [[ "$#" -ge 1 && "$1" != -* ]]; then
    __NAME="$1"
    shift
  fi

  local __TMUX_SESSION=main
  local __TERM="${TERM:-xterm-256color}"

  # already running? just re-attach.
  if [[ "$(docker inspect --format='{{.State.Running}}' "${__NAME}" 2>/dev/null)" == "true" ]]; then
    echo "re-attaching to ${__NAME} (tmux: ${__TMUX_SESSION})"
    docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
    return
  fi

  # exists but stopped? start it, then attach.
  if docker inspect "${__NAME}" &>/dev/null; then
    echo "starting stopped container ${__NAME}"
    docker start "${__NAME}" >/dev/null || return 1
    docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
    return
  fi

  # otherwise create it detached with the same mounts primate() uses.
  # HOST_* carry the host-side path of each shared dir into the container: bind mounts made
  # from inside a primate resolve on the daemon host, so `docker run -v` / compose volumes
  # need these paths, not the container's (see `hostpath` and CLAUDE.md Docker-out-of-Docker).
  local __WORKSPACE_MOUNT=()
  if [[ "$__NO_WORKSPACE" == false ]]; then
    local __HOST_WS="$(pwd)"
    __WORKSPACE_MOUNT=(--volume "${__HOST_WS}:/home/codemonkey/workspace" --env "HOST_WORKSPACE=${__HOST_WS}")
  fi

  local __ZFUNCS_DIR="${${(%):-%x}:A:h}"
  local __ENV_FILE="${__ZFUNCS_DIR}/env"
  local __ENV_FILE_MOUNT=()
  if [[ -f "$__ENV_FILE" ]]; then
    __ENV_FILE_MOUNT=(--env-file "$__ENV_FILE")
  fi

  local __GPU_OPTS=()
  if [[ "$(uname -r)" == *-nvidia ]]; then
    __GPU_OPTS=(--gpus all)
  fi

  local __PORT_OPTS=()
  local __PORTS=$(docker inspect --format='{{range $p, $_ := .Config.ExposedPorts}}{{$p}} {{end}}' "${__IMAGE}:latest" 2>/dev/null)
  for __PORT in ${=__PORTS}; do
    __PORT_OPTS+=(-p "${__PORT%/*}:${__PORT%/*}")
  done

  local __SSH_MOUNT=()
  if [[ -d ~/.ssh ]]; then
    local __HOST_SSH="$(cd -P ~/.ssh && pwd)"
    __SSH_MOUNT=(--volume "${__HOST_SSH}:/home/codemonkey/.ssh" --env "HOST_SSH_DIR=${__HOST_SSH}")
  fi

  local __AWS_MOUNT=()
  if [[ -d ~/.aws ]]; then
    local __HOST_AWS="$(cd -P ~/.aws && pwd)"
    __AWS_MOUNT=(--volume "${__HOST_AWS}:/home/codemonkey/.aws" --env "HOST_AWS_DIR=${__HOST_AWS}")
  fi

  local __DOCKER_MOUNT=()
  if [[ -S /var/run/docker.sock ]]; then
    __DOCKER_MOUNT=(--volume /var/run/docker.sock:/var/run/docker.sock --group-add "$(_primate_docker_gid)")
  fi

  echo "creating detached session ${__NAME} from ${__IMAGE} (home volume ${__IMAGE}-home)"
  docker run -d \
    --name "${__NAME}" \
    --hostname "${__IMAGE}" \
    "${__ENV_FILE_MOUNT[@]}" \
    "${__GPU_OPTS[@]}" \
    "${__PORT_OPTS[@]}" \
    "${__SSH_MOUNT[@]}" \
    "${__AWS_MOUNT[@]}" \
    "${__DOCKER_MOUNT[@]}" \
    "${__WORKSPACE_MOUNT[@]}" \
    --volume ${__IMAGE}-home:/home/codemonkey \
    --user=codemonkey:codemonkey \
    $@ \
    ${__IMAGE} sleep infinity >/dev/null || return 1

  echo "attaching (tmux: ${__TMUX_SESSION}) — detach with ctrl-b d, kill with: primate-kill ${__NAME}"
  docker exec -it -e TERM="${__TERM}" "${__NAME}" tmux new-session -A -s "${__TMUX_SESSION}"
}
compdef _primate primate-session

# stops and removes a detached primate session container (home volume persists)
function primate-kill() {
  if [[ "$#" -lt 1 ]]; then
    echo "Usage: primate-kill <image|container-name>"
    return 1
  fi
  local __NAME="$1"
  # Documented usage is `primate-kill <image>`, so resolve <image>-session FIRST: trying the bare
  # name first let an unrelated container literally named e.g. "claude" shadow claude-session and
  # be killed instead. A custom session name (primate-session <image> <name>) still resolves via
  # the exact-match fallback, as does an already-suffixed <name>-session.
  if docker inspect "${__NAME}-session" &>/dev/null; then
    __NAME="${__NAME}-session"
  elif ! docker inspect "${__NAME}" &>/dev/null; then
    echo "no such container: ${1}"
    return 1
  fi
  echo "removing ${__NAME} (home volume persists)"
  docker rm -f "${__NAME}" >/dev/null
}

# Take A Dump (takes a java heapdump in a running container)
function tad() {

  if [[ "$#" -ne 1 ]]; then
    echo "Usage: take-a-dump <target container name>"
    return 1
  fi
  local _TARGET=$1

  echo "Taking a dump of ${_TARGET}"

  _PID=$(docker exec ${_TARGET} ps aux | grep java | awk '{print $2}')
  if [[ -z ${_PID} ]]; then
	  echo "unable to to find Java process"
	  return 1
  fi
  echo "Found Java PID: ${_PID}"

  _JDK=$(docker exec ${_TARGET} ps aux | grep java | awk '{print $11}' | sed 's/\(.*\)\/java/\1/g' )
  if [[ -z ${_JDK} ]]; then
	  echo "unable to find jmap"
	  return 1
  fi
  echo "Found Java PID: ${_JDK}"

  _DATE=$(date +"%s")
  _FILENAME="${_TARGET}--heap-${_DATE}.hprof"
  echo "Taking a heap dump of ${TARGET} with PID:${_PID} using ${_JDK}/jmap -dump:format=b,file=/dumps/${TARGET}-heap-${_DATE}.hprof ${_PID}"
  docker exec ${_TARGET} $_JDK/jmap -dump:format=b,file=/dumps/${_TARGET}-heap-01.hprof $_PID

  echo "dump taken ${_FILENAME}, check in host /tmp directory"
}

function which-os() {
  local os=$(uname -a | awk '{print $1}')
  if [[ "${os}" = "Darwin" ]]; then
    echo -n "MacOS"
  elif [[ "${os}" = "Linux" ]]; then
    echo -n "Linux"
  elif [[ "${os}" = "Win32" ]]; then
    echo -n "WSL"
  else 
    return "Unknown"
  fi
}

function code-mac() {
  open -a XQuartz
  xhost +localhost

  if [[ $# = 0 ]]
  then
    open -a "Visual Studio Code"
  else
    [[ $1 = /* ]] && F="$1" || F="$PWD/${1#./}"
    open -a "Visual Studio Code" --args "$F"
  fi
}

function code-linux() {
  if [[ $# = 0 ]]
  then
    code .
  else
    code $@
  fi 
}

function code-win() {
  # TODO
}

function code-here () {
  local os=$(which-os)
  if [[ "${os}" = "Linux" ]]; then
    code-linux $@
    return
  elif [[ "${os}" = "MacOS" ]]; then
    code-mac $@
    return
  fi
}

function tree () {
  local os=$(which-os)
  if [[ "${os}" != "MacOS" ]]; then
    /usr/bin/tree $@
    return
  fi
  if [[ -n $* ]]; then
    if [[ $1 == /* ]]; then
      _TARGET=$1
    else
      _TARGET=$(pwd)/$1
    fi
    docker run --rm -e _TARGET=${_TARGET} -v ${_TARGET}:/tmp minion bash -c 'echo ${_TARGET}; cd /tmp; tree | tail -n +2 '
  else
    local _TARGET=$(pwd)
    docker run --rm -e _TARGET=${_TARGET} -v $(pwd):/tmp minion bash -c 'echo ${_TARGET}; cd /tmp; tree | tail -n +2 '
  fi
}

function TAR () {
  if [[ "$#" -ne 3 ]]; then
    echo "Usage: TAR <args> <target> <source>"
    return 1
  fi

  local _ARGS=$1
  local _TARGET=$2
  local _SOURCE=$3
  local _DEST=$(pwd)

  docker run --rm \
    -e _ARGS=${_ARGS} \
    -e _TARGET=${_TARGET} \
    -e _SOURCE=${_SOURCE} \
    -v ${_DEST}:/tmp/.TAR.ouput \
    -v ${_DEST}/${_SOURCE}:/tmp/${_SOURCE} \
    minion bash -c 'cd /tmp; tar ${_ARGS} ${_TARGET} ${_SOURCE}; mv ${_TARGET} /tmp/.TAR.ouput;'
}

function clamscan() {
  local _TARGET=
  if [[ -n $* ]]; then
    _TARGET=$1
  else
    _TARGET=$(pwd)
  fi
  docker run --rm -v ${_TARGET}:/scan minion bash -c 'clamscan -r /scan' | sed 's/\/scan\///'
}

function pmd () {
  #pmd check -d /usr/src -R rulesets/java/quickstart.xml -f text
  local _TARGET=
  if [[ -n $* ]]; then
    _TARGET=$[$#]
  else
    _TARGET=$(pwd)
  fi
    docker run --rm -e _TARGET=${_TARGET} -v $(pwd):/tmp/src minion bash -c 'echo ${_TARGET}; cd /tmp; pmd check -d /tmp/src rulesets/java/quickstart.xml -f text'
}

function watch() {
  if [[ "$#" -ne 1 ]]; then
    echo "Usage: watch <command>"
    return 1
  fi
  local _TARGET=$1
  local _STARTED=$(date)

  while (true); do
    clear
    local _LAST=$(date)

    echo "watching ${_TARGET}"
    echo "started on ${_STARTED}, last run on ${_LAST}, rerun in 2 seconds"

    echo
    zsh -c "${_TARGET}"
    sleep 2
  done
}

# Fin
